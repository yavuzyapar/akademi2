# Copy this file to .env and fill in real values there. .env is ignored by git.
#
# Nothing in this repository needs a secret today: the theme, the Black Friday
# price scripts and the promo video were scanned (files and git history) and
# contain no API keys, tokens or passwords.
#
# If a tool ever needs one (for example the Shopify CLI to push the theme),
# it belongs here and never in mavelania-theme/. Everything inside the theme
# is delivered to every visitor's browser, so a key placed there is public.

# Shopify CLI (only if you deploy the theme from the command line)
SHOPIFY_FLAG_STORE=
SHOPIFY_CLI_THEME_TOKEN=
