{%- comment -%}
  Home page: three chapters, one per signature category.

    I   Bags          cream
    II  Wallets       coffee
    III Card holders  green

  The page background glides from one chapter's colour to the next as the
  visitor scrolls (assets/mavelania-shop.js sets --ms-chapter on <html>;
  without JS each chapter carries its own colour). Each chapter opens with
  its collection photograph and a headline, then shows that category's
  products in the ledger grid.

  After chapter I the leather seal states the house's one promise; after
  chapter III, personalization by email (reply within 24 hours).

  Prices, stock and colours come from the catalogue; nothing is invented.
{%- endcomment -%}
{%- liquid
  assign bags = collections['bags']
  assign wallets = collections['wallets-purses']
  assign cards_url = routes.root_url | append: 'collections/types?q=Card%20Holder'
  if collections['card-holders'].url != blank
    assign cards_url = collections['card-holders'].url
  endif
  assign per_chapter = section.settings.products_per_chapter | default: 6
-%}
<div class="ms-home ms-chapters" data-chapters>

  {%- comment -%} ── Opening: the brand in one line, over the bag photograph ── {%- endcomment -%}
  <section class="ms-open" aria-labelledby="HomeOpenTitle" data-chapter="cream">
    <div class="ms-open__media">
      <picture>
        <source media="(max-width:760px)" srcset="{{ 'before-footer-mobile.webp' | asset_url }}" width="900" height="1599">
        <img src="{{ 'before-footer.webp' | asset_url }}" width="1400" height="622" alt="{{ 'home.slide_bag_alt' | t | escape }}" fetchpriority="high" decoding="sync">
      </picture>
    </div>
    <div class="ms-open__copy ms-wrap">
      <p class="ms-eyebrow">{{ 'home.open_eyebrow' | t }}</p>
      <h1 id="HomeOpenTitle" class="ms-open__title">{{ section.settings.intro_title }}</h1>
      <p class="ms-open__text">{{ section.settings.intro_text }}</p>
      <div class="ms-open__actions">
        <a class="ms-button ms-button--primary" href="#chapter-bags">{{ 'home.cta_discover' | t }}</a>
        <a class="ms-button ms-button--outline" href="#bespoke">{% render 'icon', name: 'pen' %} {{ 'home.cta_personalize' | t }}</a>
      </div>
      <ol class="ms-open__index" aria-label="{{ 'home.chapters_label' | t | escape }}">
        <li><a href="#chapter-bags"><span>I</span>{{ 'navigation.bags' | t }}</a></li>
        <li><a href="#chapter-wallets"><span>II</span>{{ 'navigation.wallets_short' | t }}</a></li>
        <li><a href="#chapter-cards"><span>III</span>{{ 'navigation.card_holders' | t }}</a></li>
      </ol>
    </div>
  </section>

  {% render 'ribbon' %}

  {%- comment -%} ── The three chapters ── {%- endcomment -%}
  {%- for i in (1..3) -%}
    {%- liquid
      case i
        when 1
          assign ch_id = 'chapter-bags'
          assign ch_tone = 'cream'
          assign ch_num = 'I'
          assign ch_title = 'navigation.bags' | t
          assign ch_head = section.settings.bags_title
          assign ch_text = section.settings.bags_text
          assign ch_url = bags.url | default: routes.all_products_collection_url
          assign ch_products = bags.products
          assign ch_type = ''
          assign ch_img = 'collection-bag-bordeaux.webp'
          assign ch_img_w = 1023
          assign ch_img_h = 1537
          assign ch_alt = 'home.cat_bags_alt' | t
        when 2
          assign ch_id = 'chapter-wallets'
          assign ch_tone = 'coffee'
          assign ch_num = 'II'
          assign ch_title = 'navigation.wallets_short' | t
          assign ch_head = section.settings.wallets_title
          assign ch_text = section.settings.wallets_text
          assign ch_url = wallets.url | default: routes.all_products_collection_url
          assign ch_products = wallets.products
          assign ch_type = ''
          assign ch_img = 'women-leather-wallet-model.webp'
          assign ch_img_w = 1023
          assign ch_img_h = 1537
          assign ch_alt = 'home.cat_wallets_alt' | t
        else
          assign ch_id = 'chapter-cards'
          assign ch_tone = 'green'
          assign ch_num = 'III'
          assign ch_title = 'navigation.card_holders' | t
          assign ch_head = section.settings.cards_title
          assign ch_text = section.settings.cards_text
          assign ch_url = cards_url
          assign ch_products = collections.all.products
          assign ch_type = 'Card Holder'
          assign ch_img = 'collection-hero-cardholders.webp'
          assign ch_img_w = 1888
          assign ch_img_h = 833
          assign ch_alt = 'home.slide_card_alt' | t
      endcase
      assign ch_count = 0
    -%}
    {%- capture ch_cards -%}
      {%- for product in ch_products limit: 250 -%}
        {%- if ch_type != blank and product.type != ch_type -%}{%- continue -%}{%- endif -%}
        {%- if ch_count < per_chapter -%}
          {% render 'product-card', product: product, heading: 'h3' %}
          {%- assign ch_count = ch_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if ch_count > 0 -%}
      <section class="ms-chapter ms-chapter--{{ ch_tone }}" id="{{ ch_id }}" aria-labelledby="{{ ch_id }}-title" data-chapter="{{ ch_tone }}">
        <div class="ms-wrap ms-chapter__head">
          <a class="ms-chapter__media" href="{{ ch_url }}" tabindex="-1">
            <img src="{{ ch_img | asset_url }}" alt="{{ ch_alt | escape }}" width="{{ ch_img_w }}" height="{{ ch_img_h }}" loading="lazy" decoding="async">
          </a>
          <div class="ms-chapter__copy">
            <p class="ms-chapter__num" aria-hidden="true">{{ ch_num }}</p>
            <p class="ms-eyebrow">{{ ch_title }}</p>
            <h2 id="{{ ch_id }}-title" class="ms-chapter__title">{{ ch_head }}</h2>
            <p class="ms-chapter__text">{{ ch_text }}</p>
            <a class="ms-button ms-button--primary" href="{{ ch_url }}">{{ 'home.view_all_in' | t: title: ch_title }} {% render 'icon', name: 'arrow-right' %}</a>
          </div>
        </div>
        <div class="ms-wrap">
          <div class="ms-grid ms-grid--chapter">{{ ch_cards }}</div>
        </div>
      </section>
    {%- endif -%}
    {%- if i == 1 -%}{% render 'leather-seal', tone: 'coffee' %}{%- endif -%}
  {%- endfor -%}

  {% render 'bespoke', tone: 'green' %}

  {%- comment -%} ── Also in the shop ── {%- endcomment -%}
  {%- if collections['phone-cases'].products_count > 0 or collections['accessories'].products_count > 0 -%}
    <section class="ms-also" aria-labelledby="HomeAlsoTitle" data-chapter="green">
      <div class="ms-wrap">
        <h2 id="HomeAlsoTitle" class="ms-also__title">{{ 'home.also_in_shop' | t }}</h2>
        <div class="ms-also__links">
          {%- if collections['phone-cases'].products_count > 0 -%}<a href="{{ collections['phone-cases'].url }}">{{ 'navigation.phone_cases' | t }} {% render 'icon', name: 'arrow-right' %}</a>{%- endif -%}
          {%- if collections['accessories'].products_count > 0 -%}<a href="{{ collections['accessories'].url }}">{{ 'navigation.accessories' | t }} {% render 'icon', name: 'arrow-right' %}</a>{%- endif -%}
          <a href="{{ routes.all_products_collection_url }}">{{ 'navigation.shop_all' | t }} {% render 'icon', name: 'arrow-right' %}</a>
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ── Deals: only products with a compare-at price above their price ── {%- endcomment -%}
  {%- assign deal_count = 0 -%}
  {%- capture deal_cards -%}
    {%- for product in collections.all.products limit: 250 -%}
      {%- if product.available and product.compare_at_price > product.price and deal_count < 12 -%}
        {% render 'product-card', product: product, heading: 'h3' %}
        {%- assign deal_count = deal_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if deal_count > 0 -%}
    <section class="ms-section ms-deals" aria-labelledby="HomeDealsTitle" data-chapter="cream">
      <div class="ms-wrap">
        <header class="ms-section__head">
          <div>
            <p class="ms-eyebrow">{{ 'home.deals_eyebrow' | t }}</p>
            <h2 id="HomeDealsTitle" class="ms-heading" data-deals-title>{{ 'home.deals_title' | t }}</h2>
          </div>
          <a class="ms-link" href="{{ routes.all_products_collection_url }}">{{ 'home.view_all_products' | t }} {% render 'icon', name: 'arrow-right' %}</a>
        </header>
        <div class="ms-carousel" data-carousel>
          <div class="ms-carousel__track" data-carousel-track>{{ deal_cards }}</div>
          <button class="ms-carousel__arrow ms-carousel__arrow--prev" type="button" data-carousel-prev aria-label="{{ 'general.previous' | t | escape }}">{% render 'icon', name: 'arrow-left' %}</button>
          <button class="ms-carousel__arrow ms-carousel__arrow--next" type="button" data-carousel-next aria-label="{{ 'general.next' | t | escape }}">{% render 'icon', name: 'arrow-right' %}</button>
        </div>
      </div>
    </section>
  {%- endif -%}

</div>
{% schema %}
{
  "name": "Home: chapters",
  "settings": [
    { "type": "header", "content": "Opening" },
    { "type": "text", "id": "intro_title", "label": "Headline", "default": "Crafted with Intention. Made Personal." },
    { "type": "textarea", "id": "intro_text", "label": "Text", "default": "Genuine leather bags, wallets and card holders, made by hand at Mavelania and ready to carry your name." },
    { "type": "header", "content": "Chapter I — Bags" },
    { "type": "text", "id": "bags_title", "label": "Headline", "default": "Crafted to Be Remembered." },
    { "type": "textarea", "id": "bags_text", "label": "Text", "default": "Totes, shoulder bags and briefcases, built to carry weight and to soften where your hands rest." },
    { "type": "header", "content": "Chapter II — Wallets" },
    { "type": "text", "id": "wallets_title", "label": "Headline", "default": "Everyday Essentials. Thoughtfully Crafted." },
    { "type": "textarea", "id": "wallets_text", "label": "Text", "default": "Slim profiles, sized card slots and edges finished so they stay smooth in a pocket." },
    { "type": "header", "content": "Chapter III — Card holders" },
    { "type": "text", "id": "cards_title", "label": "Headline", "default": "Your Initials. Your Identity." },
    { "type": "textarea", "id": "cards_text", "label": "Text", "default": "The smallest piece in the range, and the one most often made personal." },
    { "type": "header", "content": "Products" },
    { "type": "range", "id": "products_per_chapter", "min": 3, "max": 12, "step": 3, "default": 6, "label": "Products per chapter" }
  ],
  "presets": [{ "name": "Home: chapters" }]
}
{% endschema %}
