{%- comment -%}
  Storefront home page: category shortcuts, hero carousel with two promo
  tiles, reassurance strip, shop-by-category tiles, a featured product grid
  and a tabbed product rail per category.

  Product data is always live: prices, "from" prices, product counts, sale
  and sold-out states all come from the catalogue.
{%- endcomment -%}
{%- liquid
  assign catalog_handles = 'bags,wallets-purses,phone-cases,accessories' | split: ','
  assign bags = collections['bags']
  assign wallets = collections['wallets-purses']
  assign cases = collections['phone-cases']
  assign accessories = collections['accessories']
  assign featured = section.settings.featured_collection
  assign featured_count = section.settings.featured_count | default: 8
-%}
<div class="ms-home">

  {%- comment -%} ── Mobile category shortcuts ── {%- endcomment -%}
  <nav class="ms-chips" aria-label="{{ 'home.shop_by_category' | t | escape }}">
    {%- if bags.products_count > 0 -%}
      <a href="{{ bags.url }}"><img src="{{ 'collection-bag-bordeaux.webp' | asset_url }}" alt="" width="64" height="64" loading="eager"><span>{{ 'navigation.bags' | t }}</span></a>
    {%- endif -%}
    {%- if wallets.products_count > 0 -%}
      <a href="{{ wallets.url }}"><img src="{{ 'women-leather-wallet-model.webp' | asset_url }}" alt="" width="64" height="64" loading="eager"><span>{{ 'navigation.wallets_short' | t }}</span></a>
    {%- endif -%}
    {%- if cases.products_count > 0 -%}
      <a href="{{ cases.url }}"><img src="{{ 'phone-case-model-new.webp' | asset_url }}" alt="" width="64" height="64" loading="eager"><span>{{ 'navigation.phone_cases' | t }}</span></a>
    {%- endif -%}
    {%- if accessories.products_count > 0 -%}
      <a href="{{ accessories.url }}"><img src="{{ 'home-accessories-card.webp' | asset_url }}" alt="" width="64" height="64" loading="eager"><span>{{ 'navigation.accessories' | t }}</span></a>
    {%- endif -%}
    <a href="{{ routes.all_products_collection_url }}"><span class="ms-chips__all">{% render 'icon', name: 'bag' %}</span><span>{{ 'navigation.shop_all' | t }}</span></a>
  </nav>

  {%- comment -%} ── Hero: carousel + two promo tiles ── {%- endcomment -%}
  <section class="ms-hero" aria-label="{{ 'home.hero_label' | t | escape }}">
    <div class="ms-hero__main" data-hero aria-roledescription="carousel">
      <div class="ms-hero__slides">
        <a class="ms-hero__slide is-active" href="{{ routes.root_url }}collections/phone-cases" data-hero-slide>
          <picture><source media="(max-width:760px)" srcset="{{ 'mobile-hero-phone-cases-20260919-v2.webp' | asset_url }}"><img width="1774" height="887" src="{{ 'hero-phone-cases-20260919.webp' | asset_url }}" alt="Mavelania leather phone cases" fetchpriority="high" decoding="sync"></picture>
          <span class="ms-hero__cta">{{ 'home.shop_phone_cases' | t }} {% render 'icon', name: 'arrow-right' %}</span>
        </a>
        <a class="ms-hero__slide" href="{{ routes.root_url }}collections/bags" data-hero-slide tabindex="-1">
          <picture><source media="(max-width:760px)" data-srcset="{{ 'mobile-hero1.webp' | asset_url }}"><img width="1810" height="869" data-src="{{ 'hero1.webp' | asset_url }}" alt="Woman seated beside a Mavelania leather bag" decoding="async"></picture>
          <span class="ms-hero__cta">{{ 'home.shop_bags' | t }} {% render 'icon', name: 'arrow-right' %}</span>
        </a>
        <a class="ms-hero__slide" href="{{ routes.root_url }}collections/bags" data-hero-slide tabindex="-1">
          <picture><source media="(max-width:760px)" data-srcset="{{ 'mobile-hero2.webp' | asset_url }}"><img width="1810" height="869" data-src="{{ 'hero2.webp' | asset_url }}" alt="Man at a desk with a Mavelania leather briefcase" decoding="async"></picture>
          <span class="ms-hero__cta">{{ 'home.shop_bags' | t }} {% render 'icon', name: 'arrow-right' %}</span>
        </a>
        <a class="ms-hero__slide" href="{{ routes.root_url }}collections/bags" data-hero-slide tabindex="-1">
          <picture><source media="(max-width:760px)" data-srcset="{{ 'mobile-hero4.webp' | asset_url }}"><img width="1810" height="869" data-src="{{ 'hero4.webp' | asset_url }}" alt="Mavelania leather bag collection" decoding="async"></picture>
          <span class="ms-hero__cta">{{ 'home.shop_bags' | t }} {% render 'icon', name: 'arrow-right' %}</span>
        </a>
        <a class="ms-hero__slide" href="{{ routes.root_url }}collections/wallets-purses" data-hero-slide tabindex="-1">
          <picture><source media="(max-width:760px)" data-srcset="{{ 'mobile-hero-wallets.webp' | asset_url }}"><img width="1810" height="869" data-src="{{ 'hero-wallets.webp' | asset_url }}" alt="Mavelania wallet and card holder collection" decoding="async"></picture>
          <span class="ms-hero__cta">{{ 'home.shop_wallets' | t }} {% render 'icon', name: 'arrow-right' %}</span>
        </a>
      </div>

      <button class="ms-hero__arrow ms-hero__arrow--prev" type="button" data-hero-prev aria-label="{{ 'home.hero_previous' | t | escape }}">{% render 'icon', name: 'arrow-left' %}</button>
      <button class="ms-hero__arrow ms-hero__arrow--next" type="button" data-hero-next aria-label="{{ 'home.hero_next' | t | escape }}">{% render 'icon', name: 'arrow-right' %}</button>

      <div class="ms-hero__controls">
        <div class="ms-hero__dots" role="group" aria-label="{{ 'home.hero_selector' | t | escape }}">
          {%- for i in (1..5) -%}
            <button type="button" data-hero-dot="{{ forloop.index0 }}" aria-label="{{ 'home.hero_image' | t: index: i | escape }}"{% if forloop.first %} class="is-active" aria-current="true"{% endif %}></button>
          {%- endfor -%}
        </div>
        <button class="ms-hero__pause" type="button" data-hero-pause aria-pressed="false" aria-label="{{ 'home.hero_pause' | t | escape }}" data-pause-label="{{ 'home.hero_pause' | t | escape }}" data-resume-label="{{ 'home.hero_resume' | t | escape }}">
          <span class="ms-hero__pause-on">{% render 'icon', name: 'pause' %}</span>
          <span class="ms-hero__pause-off">{% render 'icon', name: 'play' %}</span>
        </button>
      </div>
    </div>

    <div class="ms-hero__side">
      {%- if wallets.products_count > 0 -%}
        {%- assign wallets_from = wallets.products | map: 'price_min' | sort | first | money -%}
        <a class="ms-tile" href="{{ wallets.url }}">
          <img src="{{ 'collection-hero-wallets.webp' | asset_url }}" alt="" width="1886" height="834" loading="eager" decoding="async">
          <span class="ms-tile__copy">
            <span class="ms-tile__eyebrow">{% render 'icon', name: 'rfid' %}{{ 'home.tile_wallets_eyebrow' | t }}</span>
            <strong>{{ 'collections.wallets.card_title' | t }}</strong>
            <span class="ms-tile__link">{{ 'products.from_price' | t: price: wallets_from }} {% render 'icon', name: 'arrow-right' %}</span>
          </span>
        </a>
      {%- endif -%}
      {%- if accessories.products_count > 0 -%}
        {%- assign accessories_from = accessories.products | map: 'price_min' | sort | first | money -%}
        <a class="ms-tile" href="{{ accessories.url }}">
          <img src="{{ 'collection-hero-accessories.webp' | asset_url }}" alt="" width="1651" height="953" loading="eager" decoding="async">
          <span class="ms-tile__copy">
            <span class="ms-tile__eyebrow">{{ 'home.tile_accessories_eyebrow' | t }}</span>
            <strong>{{ 'collections.accessories.card_title' | t }}</strong>
            <span class="ms-tile__link">{{ 'products.from_price' | t: price: accessories_from }} {% render 'icon', name: 'arrow-right' %}</span>
          </span>
        </a>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} ── Reassurance strip ── {%- endcomment -%}
  <div class="ms-wrap">
    {% render 'trust-strip' %}
  </div>

  {%- comment -%} ── Shop by category ── {%- endcomment -%}
  <section class="ms-section ms-wrap" aria-labelledby="HomeCategoriesTitle">
    <header class="ms-section__head">
      <div>
        <p class="ms-eyebrow">{{ 'home.shop_by_category' | t }}</p>
        <h1 id="HomeCategoriesTitle" class="ms-heading">{{ 'general.brand_signature' | t }}</h1>
      </div>
      <a class="ms-link" href="{{ routes.all_products_collection_url }}">{{ 'home.view_all_products' | t }} {% render 'icon', name: 'arrow-right' %}</a>
    </header>

    <div class="ms-cats">
      {%- if bags.products_count > 0 -%}
        <a class="ms-cat" href="{{ bags.url }}">
          <span class="ms-cat__image"><img src="{{ 'collection-bag-bordeaux.webp' | asset_url }}" alt="Woman carrying a bordeaux leather bag" width="1023" height="1537" loading="lazy" decoding="async"></span>
          <span class="ms-cat__copy"><strong>{{ 'collections.bags.card_title' | t }}</strong><span>{{ 'home.product_count' | t: count: bags.products_count }}</span></span>
          <span class="ms-cat__arrow">{% render 'icon', name: 'arrow-right' %}</span>
        </a>
      {%- endif -%}
      {%- if wallets.products_count > 0 -%}
        <a class="ms-cat" href="{{ wallets.url }}">
          <span class="ms-cat__image"><img src="{{ 'women-leather-wallet-model.webp' | asset_url }}" alt="Woman holding a leather wallet" width="1023" height="1537" loading="lazy" decoding="async"></span>
          <span class="ms-cat__copy"><strong>{{ 'collections.wallets.card_title' | t }}</strong><span>{{ 'home.product_count' | t: count: wallets.products_count }}</span></span>
          <span class="ms-cat__arrow">{% render 'icon', name: 'arrow-right' %}</span>
        </a>
      {%- endif -%}
      {%- if cases.products_count > 0 -%}
        <a class="ms-cat" href="{{ cases.url }}">
          <span class="ms-cat__image"><img src="{{ 'phone-case-model-new.webp' | asset_url }}" alt="Woman holding a leather phone case with card slots" width="1086" height="1448" loading="lazy" decoding="async"></span>
          <span class="ms-cat__copy"><strong>{{ 'collections.phone_cases.card_title' | t }}</strong><span>{{ 'home.product_count' | t: count: cases.products_count }}</span></span>
          <span class="ms-cat__arrow">{% render 'icon', name: 'arrow-right' %}</span>
        </a>
      {%- endif -%}
      {%- if accessories.products_count > 0 -%}
        <a class="ms-cat" href="{{ accessories.url }}">
          <span class="ms-cat__image"><img src="{{ 'home-accessories-card.webp' | asset_url }}" alt="Mavelania bag styled with leather accessories" width="1086" height="1448" loading="lazy" decoding="async"></span>
          <span class="ms-cat__copy"><strong>{{ 'collections.accessories.card_title' | t }}</strong><span>{{ 'home.product_count' | t: count: accessories.products_count }}</span></span>
          <span class="ms-cat__arrow">{% render 'icon', name: 'arrow-right' %}</span>
        </a>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%}
    ── Featured products ──
    A collection picked in the theme editor wins. With none selected the grid
    takes the first pieces of each category so the home page is never empty.
  {%- endcomment -%}
  <section class="ms-section ms-wrap" aria-labelledby="HomeFeaturedTitle">
    <header class="ms-section__head">
      <div>
        <p class="ms-eyebrow">{{ 'home.featured_eyebrow' | t }}</p>
        <h2 id="HomeFeaturedTitle" class="ms-heading">{{ section.settings.featured_heading | default: 'Featured pieces' }}</h2>
      </div>
      <a class="ms-link" href="{% if featured != blank and featured.products_count > 0 %}{{ featured.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">{{ 'home.view_all_products' | t }} {% render 'icon', name: 'arrow-right' %}</a>
    </header>

    <div class="ms-grid">
      {%- if featured != blank and featured.products_count > 0 -%}
        {%- for product in featured.products limit: featured_count -%}
          {% render 'product-card', product: product, heading: 'h3' %}
        {%- endfor -%}
      {%- else -%}
        {%- assign per_category = featured_count | divided_by: 4 | at_least: 1 -%}
        {%- for handle in catalog_handles -%}
          {%- comment -%} In-stock pieces only: a sold-out product should not lead the home page. {%- endcomment -%}
          {%- assign shown = 0 -%}
          {%- for product in collections[handle].products limit: 24 -%}
            {%- if product.available and shown < per_category -%}
              {% render 'product-card', product: product, heading: 'h3' %}
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} ── Products by category (tabs) ── {%- endcomment -%}
  <section class="ms-section ms-section--tint" aria-labelledby="HomeTabsTitle" data-tabs>
    <div class="ms-wrap">
      <header class="ms-section__head ms-section__head--stack">
        <div>
          <p class="ms-eyebrow">{{ 'home.collection_heading' | t }}</p>
          <h2 id="HomeTabsTitle" class="ms-heading">{{ 'home.tabs_heading' | t }}</h2>
        </div>
        <div class="ms-tabs" role="tablist" aria-label="{{ 'home.shop_by_category' | t | escape }}">
          {%- assign tab_index = 0 -%}
          {%- for handle in catalog_handles -%}
            {%- assign tab_collection = collections[handle] -%}
            {%- if tab_collection.products_count > 0 -%}
              <button type="button" role="tab" id="HomeTab-{{ handle }}" aria-controls="HomePanel-{{ handle }}" aria-selected="{% if tab_index == 0 %}true{% else %}false{% endif %}"{% if tab_index > 0 %} tabindex="-1"{% endif %} data-tab>
                {{ tab_collection.title }} <span>{{ tab_collection.products_count }}</span>
              </button>
              {%- assign tab_index = tab_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </header>

      {%- assign tab_index = 0 -%}
      {%- for handle in catalog_handles -%}
        {%- assign tab_collection = collections[handle] -%}
        {%- if tab_collection.products_count > 0 -%}
          <div class="ms-tabpanel" role="tabpanel" id="HomePanel-{{ handle }}" aria-labelledby="HomeTab-{{ handle }}" tabindex="0" data-tab-panel{% if tab_index > 0 %} hidden{% endif %}>
            <div class="ms-rail">
              {%- for product in tab_collection.products limit: 8 -%}
                {% render 'product-card', product: product, heading: 'h3', sizes: '(max-width: 700px) 62vw, (max-width: 1200px) 30vw, 22vw' %}
              {%- endfor -%}
              {%- if tab_collection.products_count > 8 -%}
                <a class="ms-rail__more" href="{{ tab_collection.url }}">
                  <span>{{ 'home.view_all_count' | t: count: tab_collection.products_count }}</span>
                  {% render 'icon', name: 'arrow-right' %}
                </a>
              {%- endif -%}
            </div>
            <p class="ms-tabpanel__foot">
              <a class="ms-button ms-button--outline" href="{{ tab_collection.url }}">{{ 'home.view_all_in' | t: title: tab_collection.title }} {% render 'icon', name: 'arrow-right' %}</a>
            </p>
          </div>
          {%- assign tab_index = tab_index | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

</div>
{% schema %}
{
  "name": "Home: shop",
  "settings": [
    { "type": "header", "content": "Featured products" },
    { "type": "collection", "id": "featured_collection", "label": "Collection to feature", "info": "Leave empty to show the first pieces of every category." },
    { "type": "text", "id": "featured_heading", "label": "Heading", "default": "Featured pieces" },
    { "type": "range", "id": "featured_count", "min": 4, "max": 12, "step": 4, "default": 8, "label": "Number of products" }
  ],
  "presets": [{ "name": "Home: shop" }]
}
{% endschema %}
