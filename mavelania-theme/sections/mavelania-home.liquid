{%- comment -%}
  Storefront home page, top half: full-width hero, reassurance strip,
  shop-by-category tiles, a featured product carousel, a wallet spotlight and
  a tabbed product carousel per category.

  Product data is always live: prices, "from" prices, product counts, colour
  dots, sale and sold-out states all come from the catalogue.
{%- endcomment -%}
{%- liquid
  assign catalog_handles = 'bags,wallets-purses,phone-cases,accessories' | split: ','
  assign bags = collections['bags']
  assign wallets = collections['wallets-purses']
  assign cases = collections['phone-cases']
  assign accessories = collections['accessories']
  assign featured = section.settings.featured_collection
  assign featured_count = section.settings.featured_count | default: 8
-%}
<div class="ms-home">

  {%- comment -%} ── Hero ── {%- endcomment -%}
  <section class="ms-hero ms-wrap" aria-label="{{ 'home.hero_label' | t | escape }}">
   <div class="ms-hero__frame" data-hero aria-roledescription="carousel">
    <div class="ms-hero__slides">
      <a class="ms-hero__slide is-active" href="{{ routes.root_url }}collections/phone-cases" data-hero-slide>
        <picture><source media="(max-width:760px)" srcset="{{ 'mobile-hero-phone-cases-20260919-v2.webp' | asset_url }}" width="941" height="1672"><img width="1774" height="887" src="{{ 'hero-phone-cases-20260919.webp' | asset_url }}" alt="Mavelania leather phone cases" fetchpriority="high" decoding="sync"></picture>
        <span class="ms-hero__cta">{{ 'home.shop_phone_cases' | t }} {% render 'icon', name: 'arrow-right' %}</span>
      </a>
      <a class="ms-hero__slide" href="{{ routes.root_url }}collections/bags" data-hero-slide tabindex="-1">
        <picture><source media="(max-width:760px)" data-srcset="{{ 'mobile-hero1.webp' | asset_url }}" width="864" height="1821"><img width="1810" height="869" data-src="{{ 'hero1.webp' | asset_url }}" alt="Woman seated beside a Mavelania leather bag" decoding="async"></picture>
        <span class="ms-hero__cta">{{ 'home.shop_bags' | t }} {% render 'icon', name: 'arrow-right' %}</span>
      </a>
      <a class="ms-hero__slide" href="{{ routes.root_url }}collections/bags" data-hero-slide tabindex="-1">
        <picture><source media="(max-width:760px)" data-srcset="{{ 'mobile-hero2.webp' | asset_url }}" width="853" height="1844"><img width="1810" height="869" data-src="{{ 'hero2.webp' | asset_url }}" alt="Man at a desk with a Mavelania leather briefcase" decoding="async"></picture>
        <span class="ms-hero__cta">{{ 'home.shop_bags' | t }} {% render 'icon', name: 'arrow-right' %}</span>
      </a>
      <a class="ms-hero__slide" href="{{ routes.root_url }}collections/bags" data-hero-slide tabindex="-1">
        <picture><source media="(max-width:760px)" data-srcset="{{ 'mobile-hero4.webp' | asset_url }}" width="852" height="1846"><img width="1810" height="869" data-src="{{ 'hero4.webp' | asset_url }}" alt="Mavelania leather bag collection" decoding="async"></picture>
        <span class="ms-hero__cta">{{ 'home.shop_bags' | t }} {% render 'icon', name: 'arrow-right' %}</span>
      </a>
      <a class="ms-hero__slide" href="{{ routes.root_url }}collections/wallets-purses" data-hero-slide tabindex="-1">
        <picture><source media="(max-width:760px)" data-srcset="{{ 'mobile-hero-wallets.webp' | asset_url }}" width="900" height="1687"><img width="1810" height="869" data-src="{{ 'hero-wallets.webp' | asset_url }}" alt="Mavelania wallet and card holder collection" decoding="async"></picture>
        <span class="ms-hero__cta">{{ 'home.shop_wallets' | t }} {% render 'icon', name: 'arrow-right' %}</span>
      </a>
    </div>

    <button class="ms-hero__arrow ms-hero__arrow--prev" type="button" data-hero-prev aria-label="{{ 'home.hero_previous' | t | escape }}">{% render 'icon', name: 'arrow-left' %}</button>
    <button class="ms-hero__arrow ms-hero__arrow--next" type="button" data-hero-next aria-label="{{ 'home.hero_next' | t | escape }}">{% render 'icon', name: 'arrow-right' %}</button>

    <div class="ms-hero__controls">
      <div class="ms-hero__dots" role="group" aria-label="{{ 'home.hero_selector' | t | escape }}">
        {%- for i in (1..5) -%}
          <button type="button" data-hero-dot="{{ forloop.index0 }}" aria-label="{{ 'home.hero_image' | t: index: i | escape }}"{% if forloop.first %} class="is-active" aria-current="true"{% endif %}></button>
        {%- endfor -%}
      </div>
      <button class="ms-hero__pause" type="button" data-hero-pause aria-pressed="false" aria-label="{{ 'home.hero_pause' | t | escape }}" data-pause-label="{{ 'home.hero_pause' | t | escape }}" data-resume-label="{{ 'home.hero_resume' | t | escape }}">
        <span class="ms-hero__pause-on">{% render 'icon', name: 'pause' %}</span>
        <span class="ms-hero__pause-off">{% render 'icon', name: 'play' %}</span>
      </button>
    </div>
   </div>
  </section>

  {%- comment -%} ── Moving ribbon of what the store commits to ── {%- endcomment -%}
  {% render 'ribbon' %}

  {%- comment -%}
    ── Deals ──
    Only products with a compare-at price above their price. The section
    disappears when nothing is reduced. During a live campaign the heading
    becomes "<campaign name> deals" (assets/mavelania-shop.js).
  {%- endcomment -%}
  {%- assign deal_count = 0 -%}
  {%- capture deal_cards -%}
    {%- for product in collections.all.products limit: 250 -%}
      {%- if product.available and product.compare_at_price > product.price and deal_count < 12 -%}
        {% render 'product-card', product: product, heading: 'h3' %}
        {%- assign deal_count = deal_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if deal_count > 0 -%}
    <section class="ms-section ms-deals" aria-labelledby="HomeDealsTitle">
      <div class="ms-wrap">
        <header class="ms-section__head">
          <div>
            <p class="ms-eyebrow">{{ 'home.deals_eyebrow' | t }}</p>
            <h2 id="HomeDealsTitle" class="ms-heading" data-deals-title>{{ 'home.deals_title' | t }}</h2>
          </div>
          <a class="ms-link" href="{{ routes.all_products_collection_url }}">{{ 'home.view_all_products' | t }} {% render 'icon', name: 'arrow-right' %}</a>
        </header>
        <div class="ms-carousel" data-carousel>
          <div class="ms-carousel__track" data-carousel-track>
            {{ deal_cards }}
          </div>
          <button class="ms-carousel__arrow ms-carousel__arrow--prev" type="button" data-carousel-prev aria-label="{{ 'general.previous' | t | escape }}">{% render 'icon', name: 'arrow-left' %}</button>
          <button class="ms-carousel__arrow ms-carousel__arrow--next" type="button" data-carousel-next aria-label="{{ 'general.next' | t | escape }}">{% render 'icon', name: 'arrow-right' %}</button>
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ── Shop by category ── {%- endcomment -%}
  <section class="ms-section ms-wrap" aria-labelledby="HomeCategoriesTitle">
    <header class="ms-section__head ms-section__head--center">
      <p class="ms-eyebrow">{{ 'home.shop_by_category' | t }}</p>
      <h1 id="HomeCategoriesTitle" class="ms-heading">{{ 'general.brand_signature' | t }}</h1>
    </header>

    <div class="ms-cats">
      {%- if bags.products_count > 0 -%}
        {%- assign cat_from = bags.products | map: 'price_min' | sort | first | money -%}
        <a class="ms-cat" href="{{ bags.url }}">
          <img src="{{ 'collection-bag-bordeaux.webp' | asset_url }}" alt="Woman carrying a bordeaux leather bag" width="1023" height="1537" loading="lazy" decoding="async">
          <span class="ms-cat__copy">
            <strong>{{ 'collections.bags.card_title' | t }}</strong>
            <span>{{ 'products.from_price' | t: price: cat_from }}</span>
            <span class="ms-cat__link">{{ 'home.shop_now' | t }} {% render 'icon', name: 'arrow-right' %}</span>
          </span>
        </a>
      {%- endif -%}
      {%- if wallets.products_count > 0 -%}
        {%- assign cat_from = wallets.products | map: 'price_min' | sort | first | money -%}
        <a class="ms-cat" href="{{ wallets.url }}">
          <img src="{{ 'women-leather-wallet-model.webp' | asset_url }}" alt="Woman holding a leather wallet" width="1023" height="1537" loading="lazy" decoding="async">
          <span class="ms-cat__copy">
            <strong>{{ 'collections.wallets.card_title' | t }}</strong>
            <span>{{ 'products.from_price' | t: price: cat_from }}</span>
            <span class="ms-cat__link">{{ 'home.shop_now' | t }} {% render 'icon', name: 'arrow-right' %}</span>
          </span>
        </a>
      {%- endif -%}
      {%- if cases.products_count > 0 -%}
        {%- assign cat_from = cases.products | map: 'price_min' | sort | first | money -%}
        <a class="ms-cat" href="{{ cases.url }}">
          <img src="{{ 'phone-case-model-new.webp' | asset_url }}" alt="Woman holding a leather phone case with card slots" width="1086" height="1448" loading="lazy" decoding="async">
          <span class="ms-cat__copy">
            <strong>{{ 'collections.phone_cases.card_title' | t }}</strong>
            <span>{{ 'products.from_price' | t: price: cat_from }}</span>
            <span class="ms-cat__link">{{ 'home.shop_now' | t }} {% render 'icon', name: 'arrow-right' %}</span>
          </span>
        </a>
      {%- endif -%}
      {%- if accessories.products_count > 0 -%}
        {%- assign cat_from = accessories.products | map: 'price_min' | sort | first | money -%}
        <a class="ms-cat" href="{{ accessories.url }}">
          <img src="{{ 'home-accessories-card.webp' | asset_url }}" alt="Mavelania bag styled with leather accessories" width="1086" height="1448" loading="lazy" decoding="async">
          <span class="ms-cat__copy">
            <strong>{{ 'collections.accessories.card_title' | t }}</strong>
            <span>{{ 'products.from_price' | t: price: cat_from }}</span>
            <span class="ms-cat__link">{{ 'home.shop_now' | t }} {% render 'icon', name: 'arrow-right' %}</span>
          </span>
        </a>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%}
    ── Featured products ──
    A collection picked in the theme editor wins. With none selected the
    carousel takes in-stock pieces from each category so it is never empty.
  {%- endcomment -%}
  <section class="ms-section ms-section--tight ms-wrap" aria-labelledby="HomeFeaturedTitle">
    <header class="ms-section__head">
      <div>
        <p class="ms-eyebrow">{{ 'home.featured_eyebrow' | t }}</p>
        <h2 id="HomeFeaturedTitle" class="ms-heading">{{ section.settings.featured_heading | default: 'Featured pieces' }}</h2>
      </div>
      <a class="ms-link" href="{% if featured != blank and featured.products_count > 0 %}{{ featured.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}">{{ 'home.view_all_products' | t }} {% render 'icon', name: 'arrow-right' %}</a>
    </header>

    <div class="ms-carousel" data-carousel>
      <div class="ms-carousel__track" data-carousel-track>
        {%- if featured != blank and featured.products_count > 0 -%}
          {%- for product in featured.products limit: featured_count -%}
            {% render 'product-card', product: product, heading: 'h3' %}
          {%- endfor -%}
        {%- else -%}
          {%- assign per_category = featured_count | divided_by: 4 | at_least: 1 -%}
          {%- for handle in catalog_handles -%}
            {%- comment -%} In-stock pieces only: a sold-out product should not lead the home page. {%- endcomment -%}
            {%- assign shown = 0 -%}
            {%- for product in collections[handle].products limit: 24 -%}
              {%- if product.available and shown < per_category -%}
                {% render 'product-card', product: product, heading: 'h3' %}
                {%- assign shown = shown | plus: 1 -%}
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
      <button class="ms-carousel__arrow ms-carousel__arrow--prev" type="button" data-carousel-prev aria-label="{{ 'general.previous' | t | escape }}">{% render 'icon', name: 'arrow-left' %}</button>
      <button class="ms-carousel__arrow ms-carousel__arrow--next" type="button" data-carousel-next aria-label="{{ 'general.next' | t | escape }}">{% render 'icon', name: 'arrow-right' %}</button>
    </div>
  </section>

  {%- comment -%} ── Wallet spotlight ── {%- endcomment -%}
  {%- if wallets.products_count > 0 -%}
    <section class="ms-section ms-wrap ms-spot" aria-labelledby="HomeSpotTitle">
      <a class="ms-spot__media" href="{{ wallets.url }}" tabindex="-1" aria-hidden="true">
        <img src="{{ 'men-leather-bag-model.webp' | asset_url }}" alt="" width="1023" height="1537" loading="lazy" decoding="async">
      </a>
      <div class="ms-spot__body">
        <p class="ms-eyebrow">{% render 'icon', name: 'rfid' %} {{ 'home.tile_wallets_eyebrow' | t }}</p>
        <h2 id="HomeSpotTitle" class="ms-heading">{{ 'collections.wallets.card_title' | t }}</h2>
        <p class="ms-spot__copy">{{ 'home.spot_wallets_copy' | t }}</p>
        <div class="ms-spot__products">
          {%- assign shown = 0 -%}
          {%- for product in wallets.products limit: 12 -%}
            {%- if product.available and shown < 2 -%}
              {% render 'product-card', product: product, heading: 'h3', sizes: '(max-width: 700px) 46vw, 20vw' %}
              {%- assign shown = shown | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
        <a class="ms-button ms-button--outline" href="{{ wallets.url }}">{{ 'home.view_all_in' | t: title: wallets.title }} {% render 'icon', name: 'arrow-right' %}</a>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%}
    ── How a piece is made ──
    Four steps, each one a line the About page and the collection pages
    already state.
  {%- endcomment -%}
  <section class="ms-craft" aria-labelledby="HomeCraftTitle">
    <div class="ms-wrap">
      <header class="ms-section__head ms-section__head--center">
        <p class="ms-eyebrow">{{ 'home.craft_eyebrow' | t }}</p>
        <h2 id="HomeCraftTitle" class="ms-heading">{{ 'home.craft_title' | t }}</h2>
      </header>
      <ol class="ms-craft__steps">
        <li class="ms-craft__step">
          <span class="ms-craft__icon">{% render 'icon', name: 'scissors' %}</span>
          <span class="ms-craft__num" aria-hidden="true">01</span>
          <h3>{{ 'home.craft_1_title' | t }}</h3>
          <p>{{ 'home.craft_1_copy' | t }}</p>
        </li>
        <li class="ms-craft__step">
          <span class="ms-craft__icon">{% render 'icon', name: 'needle' %}</span>
          <span class="ms-craft__num" aria-hidden="true">02</span>
          <h3>{{ 'home.craft_2_title' | t }}</h3>
          <p>{{ 'home.craft_2_copy' | t }}</p>
        </li>
        <li class="ms-craft__step">
          <span class="ms-craft__icon">{% render 'icon', name: 'burnish' %}</span>
          <span class="ms-craft__num" aria-hidden="true">03</span>
          <h3>{{ 'home.craft_3_title' | t }}</h3>
          <p>{{ 'home.craft_3_copy' | t }}</p>
        </li>
        <li class="ms-craft__step">
          <span class="ms-craft__icon">{% render 'icon', name: 'clock' %}</span>
          <span class="ms-craft__num" aria-hidden="true">04</span>
          <h3>{{ 'home.craft_4_title' | t }}</h3>
          <p>{{ 'home.craft_4_copy' | t }}</p>
        </li>
      </ol>
    </div>
  </section>

  {%- comment -%} ── Products by category (tabs) ── {%- endcomment -%}
  <section class="ms-section ms-section--tint" aria-labelledby="HomeTabsTitle" data-tabs>
    <div class="ms-wrap">
      <header class="ms-section__head ms-section__head--center">
        <p class="ms-eyebrow">{{ 'home.collection_heading' | t }}</p>
        <h2 id="HomeTabsTitle" class="ms-heading">{{ 'home.tabs_heading' | t }}</h2>
        <div class="ms-tabs" role="tablist" aria-label="{{ 'home.shop_by_category' | t | escape }}">
          {%- assign tab_index = 0 -%}
          {%- for handle in catalog_handles -%}
            {%- assign tab_collection = collections[handle] -%}
            {%- if tab_collection.products_count > 0 -%}
              <button type="button" role="tab" id="HomeTab-{{ handle }}" aria-controls="HomePanel-{{ handle }}" aria-selected="{% if tab_index == 0 %}true{% else %}false{% endif %}"{% if tab_index > 0 %} tabindex="-1"{% endif %} data-tab>
                {{ tab_collection.title }}
              </button>
              {%- assign tab_index = tab_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </header>

      {%- assign tab_index = 0 -%}
      {%- for handle in catalog_handles -%}
        {%- assign tab_collection = collections[handle] -%}
        {%- if tab_collection.products_count > 0 -%}
          <div class="ms-tabpanel" role="tabpanel" id="HomePanel-{{ handle }}" aria-labelledby="HomeTab-{{ handle }}" tabindex="0" data-tab-panel{% if tab_index > 0 %} hidden{% endif %}>
            <div class="ms-carousel" data-carousel>
              <div class="ms-carousel__track" data-carousel-track>
                {%- for product in tab_collection.products limit: 8 -%}
                  {% render 'product-card', product: product, heading: 'h3', within: tab_collection %}
                {%- endfor -%}
                {%- if tab_collection.products_count > 8 -%}
                  <a class="ms-carousel__more" href="{{ tab_collection.url }}">
                    <span>{{ 'home.view_all_in' | t: title: tab_collection.title }}</span>
                    {% render 'icon', name: 'arrow-right' %}
                  </a>
                {%- endif -%}
              </div>
              <button class="ms-carousel__arrow ms-carousel__arrow--prev" type="button" data-carousel-prev aria-label="{{ 'general.previous' | t | escape }}">{% render 'icon', name: 'arrow-left' %}</button>
              <button class="ms-carousel__arrow ms-carousel__arrow--next" type="button" data-carousel-next aria-label="{{ 'general.next' | t | escape }}">{% render 'icon', name: 'arrow-right' %}</button>
            </div>
            <p class="ms-tabpanel__foot">
              <a class="ms-button ms-button--outline" href="{{ tab_collection.url }}">{{ 'home.view_all_in' | t: title: tab_collection.title }} {% render 'icon', name: 'arrow-right' %}</a>
            </p>
          </div>
          {%- assign tab_index = tab_index | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

</div>
{% schema %}
{
  "name": "Home: shop",
  "settings": [
    { "type": "header", "content": "Featured products" },
    { "type": "collection", "id": "featured_collection", "label": "Collection to feature", "info": "Leave empty to show in-stock pieces from every category." },
    { "type": "text", "id": "featured_heading", "label": "Heading", "default": "Featured pieces" },
    { "type": "range", "id": "featured_count", "min": 4, "max": 12, "step": 4, "default": 8, "label": "Number of products" }
  ],
  "presets": [{ "name": "Home: shop" }]
}
{% endschema %}
