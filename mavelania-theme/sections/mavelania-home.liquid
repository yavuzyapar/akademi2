{%- comment -%}
  Home page, first half: the three-slide hero (bag, wallet, card holder),
  the brand line with the personalization message, selected essentials,
  "Make It Yours", the three collections and, when products are reduced,
  the deals rail.

  Everything about a product (price, availability, personalization) is
  read from the catalogue. A slide or card that says "personalizable" only
  does so when the product's own data says it.
{%- endcomment -%}
{%- liquid
  assign bags = collections['bags']
  assign wallets = collections['wallets-purses']
  assign cards_url = routes.root_url | append: 'collections/types?q=Card%20Holder'
  if collections['card-holders'].url != blank
    assign cards_url = collections['card-holders'].url
  endif
  assign personalize_url = routes.all_products_collection_url | append: '?view=personalize'
  if pages['personalize'].url != blank
    assign personalize_url = pages['personalize'].url
  endif

  assign signature_bag = section.settings.signature_bag
  assign signature_wallet = section.settings.signature_wallet
  assign signature_card = section.settings.signature_card
-%}
{%- capture card_pers -%}{%- if signature_card != blank -%}{% render 'personalization-info', product: signature_card %}{%- endif -%}{%- endcapture -%}
{%- assign card_pers = card_pers | strip -%}

<div class="ms-home">

  {%- comment -%} ── Hero: bag first, then wallet, then card holder ── {%- endcomment -%}
  <section class="ms-hero ms-wrap" aria-label="{{ 'home.hero_label' | t | escape }}">
   <div class="ms-hero__frame" data-hero aria-roledescription="carousel">
    <div class="ms-hero__slides">

      <div class="ms-hero__slide ms-hero__slide--left is-active" data-hero-slide>
        <picture>
          <source media="(max-width:760px)" srcset="{{ 'before-footer-mobile.webp' | asset_url }}" width="900" height="1599">
          <img src="{{ 'before-footer.webp' | asset_url }}" width="1400" height="622" alt="{{ 'home.slide_bag_alt' | t | escape }}" fetchpriority="high" decoding="sync" style="--pos-m: center 22%">
        </picture>
        <div class="ms-hero__text">
          <p class="ms-hero__eyebrow">{{ 'navigation.bags' | t }}</p>
          <h2 class="ms-hero__title">{{ section.settings.slide_bag_title }}</h2>
          <a class="ms-button ms-button--primary" href="{{ bags.url | default: routes.all_products_collection_url }}">{{ section.settings.slide_bag_cta }} {% render 'icon', name: 'arrow-right' %}</a>
        </div>
      </div>

      <div class="ms-hero__slide ms-hero__slide--top" data-hero-slide aria-hidden="true">
        <picture>
          <source media="(max-width:760px)" data-srcset="{{ 'women-leather-wallet-model.webp' | asset_url }}" width="1023" height="1537">
          <img data-src="{{ 'collection-hero-wallets.webp' | asset_url }}" width="1886" height="834" alt="{{ 'home.slide_wallet_alt' | t | escape }}" decoding="async" style="--pos-m: center 30%">
        </picture>
        <div class="ms-hero__text">
          <p class="ms-hero__eyebrow">{{ 'navigation.wallets_short' | t }}</p>
          <h2 class="ms-hero__title">{{ section.settings.slide_wallet_title }}</h2>
          <a class="ms-button ms-button--primary" href="{{ wallets.url | default: routes.all_products_collection_url }}" tabindex="-1">{{ section.settings.slide_wallet_cta }} {% render 'icon', name: 'arrow-right' %}</a>
        </div>
      </div>

      <div class="ms-hero__slide ms-hero__slide--top" data-hero-slide aria-hidden="true">
        <picture>
          {%- if signature_card.featured_image -%}
            <source media="(max-width:760px)" data-srcset="{{ signature_card.featured_image | image_url: width: 900 }}" width="{{ signature_card.featured_image.width }}" height="{{ signature_card.featured_image.height }}">
          {%- endif -%}
          <img data-src="{{ 'collection-hero-cardholders.webp' | asset_url }}" width="1888" height="833" alt="{{ 'home.slide_card_alt' | t | escape }}" decoding="async" style="--pos-m: center 40%">
        </picture>
        <div class="ms-hero__text">
          <p class="ms-hero__eyebrow">{{ 'navigation.card_holders' | t }}</p>
          {%- if card_pers != blank -%}
            {%- comment -%} This card holder really can be personalized. {%- endcomment -%}
            <h2 class="ms-hero__title">{{ section.settings.slide_card_title }}</h2>
            <a class="ms-button ms-button--primary" href="{{ signature_card.url }}#personalize" tabindex="-1">{{ section.settings.slide_card_cta }} {% render 'icon', name: 'arrow-right' %}</a>
          {%- else -%}
            <h2 class="ms-hero__title">{{ section.settings.slide_card_title_plain }}</h2>
            <a class="ms-button ms-button--primary" href="{{ cards_url }}" tabindex="-1">{{ section.settings.slide_card_cta_plain }} {% render 'icon', name: 'arrow-right' %}</a>
          {%- endif -%}
        </div>
      </div>
    </div>

    <a class="ms-hero__pers" href="{{ personalize_url }}">
      {% render 'icon', name: 'pen' %}
      <span>{{ 'home.personal_line' | t }}</span>
    </a>

    <button class="ms-hero__arrow ms-hero__arrow--prev" type="button" data-hero-prev aria-label="{{ 'home.hero_previous' | t | escape }}">{% render 'icon', name: 'arrow-left' %}</button>
    <button class="ms-hero__arrow ms-hero__arrow--next" type="button" data-hero-next aria-label="{{ 'home.hero_next' | t | escape }}">{% render 'icon', name: 'arrow-right' %}</button>

    <div class="ms-hero__controls">
      <div class="ms-hero__dots" role="group" aria-label="{{ 'home.hero_selector' | t | escape }}">
        {%- for i in (1..3) -%}
          <button type="button" data-hero-dot="{{ forloop.index0 }}" aria-label="{{ 'home.hero_image' | t: index: i | escape }}"{% if forloop.first %} class="is-active" aria-current="true"{% endif %}></button>
        {%- endfor -%}
      </div>
      <button class="ms-hero__pause" type="button" data-hero-pause aria-pressed="false" aria-label="{{ 'home.hero_pause' | t | escape }}" data-pause-label="{{ 'home.hero_pause' | t | escape }}" data-resume-label="{{ 'home.hero_resume' | t | escape }}">
        <span class="ms-hero__pause-on">{% render 'icon', name: 'pause' %}</span>
        <span class="ms-hero__pause-off">{% render 'icon', name: 'play' %}</span>
      </button>
    </div>
   </div>
  </section>

  {%- comment -%} ── Brand line: what Mavelania is, in one breath ── {%- endcomment -%}
  <section class="ms-intro ms-wrap" aria-labelledby="HomeIntroTitle">
    <div class="ms-intro__copy">
      <p class="ms-eyebrow">{{ 'general.brand_signature' | t }}</p>
      <h1 id="HomeIntroTitle" class="ms-intro__title">{{ section.settings.intro_title }}</h1>
      <p class="ms-intro__text">{{ section.settings.intro_text }}</p>
    </div>
    <div class="ms-intro__actions">
      <a class="ms-button ms-button--primary" href="{{ routes.all_products_collection_url }}">{{ 'home.cta_discover' | t }}</a>
      <a class="ms-button ms-button--outline" href="{{ personalize_url }}">{% render 'icon', name: 'pen' %} {{ 'home.cta_personalize' | t }}</a>
      <p class="ms-intro__personal">{{ 'home.personal_line' | t }}</p>
    </div>
  </section>

  {% render 'ribbon' %}

  {%- comment -%} ── Selected essentials: exactly three pieces ── {%- endcomment -%}
  <section class="ms-section ms-wrap" aria-labelledby="HomeEssentialsTitle">
    <header class="ms-section__head ms-section__head--center">
      <p class="ms-eyebrow">{{ 'home.essentials_eyebrow' | t }}</p>
      <h2 id="HomeEssentialsTitle" class="ms-heading">{{ 'home.essentials_title' | t }}</h2>
      <p class="ms-section__lede">{{ 'home.essentials_text' | t }}</p>
    </header>
    <div class="ms-essentials">
      {%- for essential in (1..3) -%}
        {%- case forloop.index -%}
          {%- when 1 -%}{%- assign piece = signature_bag -%}{%- assign piece_label = 'home.essential_bag' | t -%}
          {%- when 2 -%}{%- assign piece = signature_wallet -%}{%- assign piece_label = 'home.essential_wallet' | t -%}
          {%- else -%}{%- assign piece = signature_card -%}{%- assign piece_label = 'home.essential_card' | t -%}
        {%- endcase -%}
        {%- if piece != blank -%}
          {% render 'essential-card', product: piece, label: piece_label %}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>

  {% render 'make-it-yours', personalize_url: personalize_url, image: section.settings.personal_image %}

  {%- comment -%} ── The three collections ── {%- endcomment -%}
  <section class="ms-section ms-wrap" aria-labelledby="HomeCategoriesTitle">
    <header class="ms-section__head ms-section__head--center">
      <p class="ms-eyebrow">{{ 'home.shop_by_category' | t }}</p>
      <h2 id="HomeCategoriesTitle" class="ms-heading">{{ 'home.collections_title' | t }}</h2>
    </header>
    <div class="ms-cats ms-cats--three">
      <a class="ms-cat" href="{{ bags.url | default: routes.all_products_collection_url }}">
        <img src="{{ 'collection-bag-bordeaux.webp' | asset_url }}" alt="{{ 'home.cat_bags_alt' | t | escape }}" width="1023" height="1537" loading="lazy" decoding="async">
        <span class="ms-cat__copy"><strong>{{ 'navigation.bags' | t }}</strong><span class="ms-cat__link">{{ 'home.shop_now' | t }} {% render 'icon', name: 'arrow-right' %}</span></span>
      </a>
      <a class="ms-cat" href="{{ wallets.url | default: routes.all_products_collection_url }}">
        <img src="{{ 'women-leather-wallet-model.webp' | asset_url }}" alt="{{ 'home.cat_wallets_alt' | t | escape }}" width="1023" height="1537" loading="lazy" decoding="async">
        <span class="ms-cat__copy"><strong>{{ 'navigation.wallets_short' | t }}</strong><span class="ms-cat__link">{{ 'home.shop_now' | t }} {% render 'icon', name: 'arrow-right' %}</span></span>
      </a>
      <a class="ms-cat" href="{{ cards_url }}">
        {%- if signature_card.featured_image -%}
          {{ signature_card.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '480,720,900', sizes: '(max-width: 900px) 46vw, 30vw', alt: signature_card.featured_image.alt | default: signature_card.title }}
        {%- else -%}
          <img src="{{ 'collection-hero-cardholders.webp' | asset_url }}" alt="" width="1888" height="833" loading="lazy" decoding="async">
        {%- endif -%}
        <span class="ms-cat__copy"><strong>{{ 'navigation.card_holders' | t }}</strong><span class="ms-cat__link">{{ 'home.shop_now' | t }} {% render 'icon', name: 'arrow-right' %}</span></span>
      </a>
    </div>
    <p class="ms-cats__more">
      {{ 'home.also_in_shop' | t }}
      {%- if collections['phone-cases'].products_count > 0 %} <a href="{{ collections['phone-cases'].url }}">{{ 'navigation.phone_cases' | t }}</a>{% endif %}
      {%- if collections['accessories'].products_count > 0 %} · <a href="{{ collections['accessories'].url }}">{{ 'navigation.accessories' | t }}</a>{% endif %}
    </p>
  </section>

  {%- comment -%}
    ── Deals ── only products with a compare-at price above their price.
    Absent when nothing is reduced.
  {%- endcomment -%}
  {%- assign deal_count = 0 -%}
  {%- capture deal_cards -%}
    {%- for product in collections.all.products limit: 250 -%}
      {%- if product.available and product.compare_at_price > product.price and deal_count < 12 -%}
        {% render 'product-card', product: product, heading: 'h3' %}
        {%- assign deal_count = deal_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if deal_count > 0 -%}
    <section class="ms-section ms-deals" aria-labelledby="HomeDealsTitle">
      <div class="ms-wrap">
        <header class="ms-section__head">
          <div>
            <p class="ms-eyebrow">{{ 'home.deals_eyebrow' | t }}</p>
            <h2 id="HomeDealsTitle" class="ms-heading" data-deals-title>{{ 'home.deals_title' | t }}</h2>
          </div>
          <a class="ms-link" href="{{ routes.all_products_collection_url }}">{{ 'home.view_all_products' | t }} {% render 'icon', name: 'arrow-right' %}</a>
        </header>
        <div class="ms-carousel" data-carousel>
          <div class="ms-carousel__track" data-carousel-track>{{ deal_cards }}</div>
          <button class="ms-carousel__arrow ms-carousel__arrow--prev" type="button" data-carousel-prev aria-label="{{ 'general.previous' | t | escape }}">{% render 'icon', name: 'arrow-left' %}</button>
          <button class="ms-carousel__arrow ms-carousel__arrow--next" type="button" data-carousel-next aria-label="{{ 'general.next' | t | escape }}">{% render 'icon', name: 'arrow-right' %}</button>
        </div>
      </div>
    </section>
  {%- endif -%}

</div>
{% schema %}
{
  "name": "Home: brand",
  "settings": [
    { "type": "header", "content": "Hero slides", "info": "The bag is always the first slide. Each slide links to its collection." },
    { "type": "text", "id": "slide_bag_title", "label": "Slide 1 (bag) headline", "default": "Crafted to Be Remembered." },
    { "type": "text", "id": "slide_bag_cta", "label": "Slide 1 button", "default": "Discover bags" },
    { "type": "text", "id": "slide_wallet_title", "label": "Slide 2 (wallet) headline", "default": "Everyday Essentials. Thoughtfully Crafted." },
    { "type": "text", "id": "slide_wallet_cta", "label": "Slide 2 button", "default": "Explore wallets" },
    { "type": "text", "id": "slide_card_title", "label": "Slide 3 headline, when the card holder can be personalized", "default": "Your Initials. Your Identity." },
    { "type": "text", "id": "slide_card_cta", "label": "Slide 3 button, when the card holder can be personalized", "default": "Personalize your piece" },
    { "type": "text", "id": "slide_card_title_plain", "label": "Slide 3 headline, otherwise", "default": "Small in Size. Considered in Detail.", "info": "Shown while the signature card holder has no personalization in its product data." },
    { "type": "text", "id": "slide_card_cta_plain", "label": "Slide 3 button, otherwise", "default": "Explore card holders" },
    { "type": "header", "content": "Brand line" },
    { "type": "text", "id": "intro_title", "label": "Headline", "default": "Crafted with Intention. Made Personal." },
    { "type": "textarea", "id": "intro_text", "label": "Text", "default": "Discover thoughtfully crafted leather goods, personalized to reflect your individual style." },
    { "type": "header", "content": "Selected essentials", "info": "Exactly three pieces: a bag, a wallet and a card holder. Choose pieces that are in stock." },
    { "type": "product", "id": "signature_bag", "label": "Signature bag" },
    { "type": "product", "id": "signature_wallet", "label": "Everyday wallet" },
    { "type": "product", "id": "signature_card", "label": "Card holder", "info": "Also used for slide 3 on phones." },
    { "type": "header", "content": "Make It Yours" },
    { "type": "image_picker", "id": "personal_image", "label": "Photo of a personalized piece", "info": "Use a real photo of initials or a name on one of your products. Until one is set, the section shows a live preview of the customer's own text instead." }
  ],
  "presets": [{ "name": "Home: brand" }]
}
{% endschema %}
