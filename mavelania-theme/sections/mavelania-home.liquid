{%- comment -%}
  Home page: three chapters, one per signature category.

    I   Bags          cream
    II  Wallets       coffee
    III Card holders  green

  The page background glides from one chapter's colour to the next as the
  visitor scrolls (assets/mavelania-shop.js sets --ms-chapter on <html>;
  without JS each chapter carries its own colour). Each chapter opens with
  its collection photograph and a headline, then shows that category's
  products in the ledger grid.

  After chapter I the leather seal states the house's one promise; after
  chapter III, personalization by email (reply within 24 hours).

  Prices, stock and colours come from the catalogue; nothing is invented.
{%- endcomment -%}
{%- liquid
  assign bags = collections['bags']
  assign wallets = collections['wallets-purses']
  assign cards_url = routes.root_url | append: 'collections/types?q=Card%20Holder'
  if collections['card-holders'].url != blank
    assign cards_url = collections['card-holders'].url
  endif
  assign per_chapter = section.settings.products_per_chapter | default: 4
-%}
<div class="ms-home ms-chapters" data-chapters>

  {%- comment -%} ── Opening: the brand in one line, over the bag photograph ── {%- endcomment -%}
  {%- assign open_film = section.settings.open_film -%}
  <section class="ms-open{% if open_film %} ms-open--film{% endif %}" aria-labelledby="HomeOpenTitle" data-chapter="cream">
    <div class="ms-open__media">
      {%- if open_film -%}
        <div class="ms-open__film" data-hero-film>
          {%- if section.settings.open_video != blank -%}
            {{ section.settings.open_video | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, preload: 'none', class: 'ms-open__video', image_size: '1600x', data-hero-video: '' }}
          {%- else -%}
            {%- comment -%} Tablets and computers play the wide film (assets/hero-alicia-wide.mp4, 16:9), phones the portrait one: the browser picks the source by screen width and starts it on its own, muted, as the page opens. The first frame shows underneath until then. {%- endcomment -%}
            <picture class="ms-open__poster">
              <source media="(max-width: 760px)" srcset="{{ 'hero-alicia-poster.webp' | asset_url }}" width="720" height="1280">
              <img src="{{ 'hero-alicia-wide-poster.webp' | asset_url }}" alt="" width="1920" height="1080" fetchpriority="high" aria-hidden="true">
            </picture>
            <video class="ms-open__video" autoplay muted loop playsinline preload="auto" width="1920" height="1080" aria-label="{{ 'home.film_alt' | t | escape }}" data-hero-video>
              <source src="{{ 'hero-alicia-wide.mp4' | asset_url }}" type="video/mp4" media="(min-width: 761px)">
              <source src="{{ 'hero-alicia.mp4' | asset_url }}" type="video/mp4">
            </video>
          {%- endif -%}
        </div>
      {%- else -%}
      {%- liquid
        assign open_img = section.settings.open_image
        assign open_img_m = section.settings.open_image_mobile | default: open_img
      -%}
      <picture>
        {%- if open_img_m != blank -%}
          <source media="(max-width:760px)" srcset="{{ open_img_m | image_url: width: 750 }} 750w, {{ open_img_m | image_url: width: 1100 }} 1100w, {{ open_img_m | image_url: width: 1500 }} 1500w" sizes="100vw" width="{{ open_img_m.width }}" height="{{ open_img_m.height }}">
        {%- else -%}
          <source media="(max-width:760px)" srcset="{{ 'before-footer-mobile.webp' | asset_url }}" width="900" height="1599">
        {%- endif -%}
        {%- if open_img != blank -%}
          <img src="{{ open_img | image_url: width: 1800 }}" srcset="{{ open_img | image_url: width: 1200 }} 1200w, {{ open_img | image_url: width: 1800 }} 1800w, {{ open_img | image_url: width: 2400 }} 2400w, {{ open_img | image_url: width: 3000 }} 3000w" sizes="100vw" width="{{ open_img.width }}" height="{{ open_img.height }}" alt="{{ open_img.alt | default: 'home.slide_bag_alt' | t | escape }}" fetchpriority="high">
        {%- else -%}
          <img src="{{ 'before-footer.webp' | asset_url }}" width="1400" height="622" alt="{{ 'home.slide_bag_alt' | t | escape }}" fetchpriority="high">
        {%- endif -%}
      </picture>
      {%- endif -%}
    </div>
    <div class="ms-open__copy ms-wrap">
      <p class="ms-eyebrow">{{ 'home.open_eyebrow' | t }}</p>
      <h1 id="HomeOpenTitle" class="ms-open__title">{{ section.settings.intro_title }}</h1>
      <p class="ms-open__text">{{ section.settings.intro_text }}</p>
      <div class="ms-open__actions">
        <a class="ms-button ms-button--primary" href="#chapter-bags">{{ 'home.cta_discover' | t }}</a>
        <a class="ms-button ms-button--outline" href="#bespoke">{% render 'icon', name: 'pen' %} {{ 'home.cta_personalize' | t }}</a>
      </div>
    </div>
  </section>

  {% render 'ribbon' %}

  {%- comment -%} ── The three chapters ── {%- endcomment -%}
  {%- for i in (1..3) -%}
    {%- liquid
      assign ch_bare = false
      case i
        when 1
          assign ch_id = 'chapter-bags'
          assign ch_tone = 'cream'
          assign ch_num = 'I'
          assign ch_title = 'navigation.bags' | t
          assign ch_head = section.settings.bags_title
          assign ch_text = section.settings.bags_text
          assign ch_url = bags.url | default: routes.all_products_collection_url
          assign ch_products = bags.products
          assign ch_type = ''
          assign ch_img = 'collection-bag-bordeaux.webp'
          assign ch_pick = section.settings.bags_image
          # Bags: no film and no photo beside the words, unless a piece or a
          # photo is chosen in the theme editor.
          assign ch_film_handle = section.settings.bags_film_product.handle
          assign ch_own_film = ''
          if section.settings.bags_film_product == blank and ch_pick == blank
            assign ch_bare = true
          endif
          assign ch_img_w = 1023
          assign ch_img_h = 1537
          assign ch_alt = 'home.cat_bags_alt' | t
        when 2
          assign ch_id = 'chapter-wallets'
          assign ch_tone = 'coffee'
          assign ch_num = 'II'
          assign ch_title = 'navigation.wallets_short' | t
          assign ch_head = section.settings.wallets_title
          assign ch_text = section.settings.wallets_text
          assign ch_url = wallets.url | default: routes.all_products_collection_url
          assign ch_products = wallets.products
          assign ch_type = ''
          assign ch_img = 'women-leather-wallet-model.webp'
          assign ch_pick = section.settings.wallets_image
          # Wallets: the making of a piece, from the first cut to the street.
          assign ch_film_handle = section.settings.wallets_film_product.handle | default: ''
          assign ch_own_film = 'home-wallets'
          if section.settings.wallets_film_product != blank
            assign ch_own_film = ''
          endif
          assign ch_img_w = 1023
          assign ch_img_h = 1537
          assign ch_alt = 'home.cat_wallets_alt' | t
        else
          assign ch_id = 'chapter-cards'
          assign ch_tone = 'green'
          assign ch_num = 'III'
          assign ch_title = 'navigation.card_holders' | t
          assign ch_head = section.settings.cards_title
          assign ch_text = section.settings.cards_text
          assign ch_url = cards_url
          assign ch_products = collections.all.products
          assign ch_type = 'Card Holder'
          assign ch_img = 'collection-hero-cardholders.webp'
          assign ch_pick = section.settings.cards_image
          assign ch_film_handle = section.settings.cards_film_product.handle | default: 'valeria-leather-shoulder-bag'
          assign ch_own_film = 'film-valeria'
          if section.settings.cards_film_product != blank
            assign ch_own_film = ''
          endif
          assign ch_img_w = 1888
          assign ch_img_h = 833
          assign ch_alt = 'home.slide_card_alt' | t
      endcase
      assign ch_count = 0
    -%}
    {%- capture ch_cards -%}
      {%- for product in ch_products limit: 250 -%}
        {%- if ch_type != blank and product.type != ch_type -%}{%- continue -%}{%- endif -%}
        {%- if ch_count < per_chapter -%}
          {% render 'product-card', product: product, heading: 'h3' %}
          {%- assign ch_count = ch_count | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if ch_count > 0 -%}
      {%- liquid
        assign ch_film = ''
        assign ch_film_product = blank
        if section.settings.chapter_films and ch_pick == blank
          assign ch_film_product = all_products[ch_film_handle]
          if ch_own_film != blank
            # The chapter's own calm film (assets/home-*.mp4): one scene of
            # the piece, no cuts between people.
            assign ch_film = ch_own_film
          else
            capture ch_film
              render 'film-name', handle: ch_film_product.handle
            endcapture
            assign ch_film = ch_film | strip | split: '|' | first
          endif
        endif
      -%}
      <section class="ms-chapter ms-chapter--{{ ch_tone }}{% if i == 2 %} ms-chapter--flip{% endif %}" id="{{ ch_id }}" aria-labelledby="{{ ch_id }}-title" data-chapter="{{ ch_tone }}">
        <div class="ms-wrap ms-feature{% if ch_film != blank %} ms-feature--film{% elsif ch_bare %} ms-feature--bare{% endif %}">
          {%- unless ch_bare and ch_film == blank -%}
          <div class="ms-feature__media">
            {%- if ch_film != blank -%}
              {% render 'film', name: ch_film, label: ch_alt, product: ch_film_product %}
            {%- else -%}
              <a class="ms-chapter__media" href="{{ ch_url }}" tabindex="-1">
                {%- if ch_pick != blank -%}
                  {{ ch_pick | image_url: width: 1200 | image_tag: widths: '500,800,1200', sizes: '(min-width: 1000px) 28vw, 100vw', loading: 'lazy', alt: ch_alt }}
                {%- else -%}
                  <img src="{{ ch_img | asset_url }}" alt="{{ ch_alt | escape }}" width="{{ ch_img_w }}" height="{{ ch_img_h }}" loading="lazy" decoding="async">
                {%- endif -%}
              </a>
            {%- endif -%}
          </div>
          {%- endunless -%}
          <header class="ms-feature__head">
            <div class="ms-feature__title">
              <p class="ms-chapter__num" aria-hidden="true">{{ ch_num }}</p>
              <p class="ms-eyebrow">{{ ch_title }}</p>
              <h2 id="{{ ch_id }}-title" class="ms-chapter__title">{{ ch_head }}</h2>
            </div>
            <div class="ms-feature__lede">
              <p class="ms-chapter__text">{{ ch_text }}</p>
            </div>
          </header>
          <div class="ms-grid ms-grid--chapter ms-feature__grid">{{ ch_cards }}</div>
          <div class="ms-feature__foot">
            <a class="ms-button ms-button--primary" href="{{ ch_url }}">{{ 'home.view_all_in' | t: title: ch_title }} {% render 'icon', name: 'arrow-right' %}</a>
          </div>
        </div>
      </section>
    {%- endif -%}
    {%- if i == 1 -%}{% render 'leather-seal', tone: 'cream' %}{%- endif -%}
  {%- endfor -%}

  {% render 'bespoke', tone: 'green' %}

  {%- comment -%} ── Also in the shop ── {%- endcomment -%}
  {%- if collections['phone-cases'].products_count > 0 or collections['accessories'].products_count > 0 -%}
    <section class="ms-also" aria-labelledby="HomeAlsoTitle" data-chapter="green">
      <div class="ms-wrap">
        <h2 id="HomeAlsoTitle" class="ms-also__title">{{ 'home.also_in_shop' | t }}</h2>
        <div class="ms-also__links">
          {%- if collections['phone-cases'].products_count > 0 -%}<a href="{{ collections['phone-cases'].url }}">{{ 'navigation.phone_cases' | t }} {% render 'icon', name: 'arrow-right' %}</a>{%- endif -%}
          {%- if collections['accessories'].products_count > 0 -%}<a href="{{ collections['accessories'].url }}">{{ 'navigation.accessories' | t }} {% render 'icon', name: 'arrow-right' %}</a>{%- endif -%}
          <a href="{{ routes.all_products_collection_url }}">{{ 'navigation.shop_all' | t }} {% render 'icon', name: 'arrow-right' %}</a>
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ── Deals: only products with a compare-at price above their price ── {%- endcomment -%}
  {%- assign deal_count = 0 -%}
  {%- capture deal_cards -%}
    {%- for product in collections.all.products limit: 250 -%}
      {%- if product.available and product.compare_at_price > product.price and deal_count < 12 -%}
        {% render 'product-card', product: product, heading: 'h3' %}
        {%- assign deal_count = deal_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if deal_count > 0 -%}
    <section class="ms-section ms-deals" aria-labelledby="HomeDealsTitle" data-chapter="cream">
      <div class="ms-wrap">
        <header class="ms-section__head">
          <div>
            <p class="ms-eyebrow">{{ 'home.deals_eyebrow' | t }}</p>
            <h2 id="HomeDealsTitle" class="ms-heading" data-deals-title>{{ 'home.deals_title' | t }}</h2>
          </div>
          <a class="ms-link" href="{{ routes.all_products_collection_url }}">{{ 'home.view_all_products' | t }} {% render 'icon', name: 'arrow-right' %}</a>
        </header>
        <div class="ms-carousel" data-carousel>
          <div class="ms-carousel__track" data-carousel-track>{{ deal_cards }}</div>
          <button class="ms-carousel__arrow ms-carousel__arrow--prev" type="button" data-carousel-prev aria-label="{{ 'general.previous' | t | escape }}">{% render 'icon', name: 'arrow-left' %}</button>
          <button class="ms-carousel__arrow ms-carousel__arrow--next" type="button" data-carousel-next aria-label="{{ 'general.next' | t | escape }}">{% render 'icon', name: 'arrow-right' %}</button>
        </div>
      </div>
    </section>
  {%- endif -%}

</div>
{% schema %}
{
  "name": "Home: chapters",
  "settings": [
    { "type": "header", "content": "Opening" },
    { "type": "checkbox", "id": "open_film", "label": "Play the film in the opening", "default": true, "info": "Off: the photos below are shown instead." },
    { "type": "video", "id": "open_video", "label": "Film (optional)", "info": "Leave empty to use the film included in the theme. Uploaded films play muted and on a loop." },
    { "type": "image_picker", "id": "open_image", "label": "Photo (desktop)", "info": "Optional. Wide photo, about 2400 × 1066 px." },
    { "type": "image_picker", "id": "open_image_mobile", "label": "Photo (phones)", "info": "Portrait, about 1350 × 2400 px." },
    { "type": "text", "id": "intro_title", "label": "Headline", "default": "Crafted with Intention. Made Personal." },
    { "type": "textarea", "id": "intro_text", "label": "Text", "default": "Genuine leather bags, wallets and card holders, made by hand at Mavelania and ready to carry your name." },
    { "type": "header", "content": "Films" },
    { "type": "checkbox", "id": "chapter_films", "label": "Play a short film in each chapter", "default": true, "info": "Off, or when a chapter photo is chosen below: the photo is shown instead." },
    { "type": "header", "content": "Chapter I — Bags" },
    { "type": "product", "id": "bags_film_product", "label": "Piece whose film plays", "info": "Leave empty to show no film in this chapter. Only pieces that have a film can be used." },
    { "type": "image_picker", "id": "bags_image", "label": "Photo", "info": "Optional. Upload the original photo for the sharpest result." },
    { "type": "text", "id": "bags_title", "label": "Headline", "default": "Crafted to Be Remembered." },
    { "type": "textarea", "id": "bags_text", "label": "Text", "default": "Totes, shoulder bags and briefcases, built to carry weight and to soften where your hands rest." },
    { "type": "header", "content": "Chapter II — Wallets" },
    { "type": "product", "id": "wallets_film_product", "label": "Piece whose film plays", "info": "Leave empty for the theme's own making-of film." },
    { "type": "image_picker", "id": "wallets_image", "label": "Photo", "info": "Optional. Upload the original photo for the sharpest result." },
    { "type": "text", "id": "wallets_title", "label": "Headline", "default": "Everyday Essentials. Thoughtfully Crafted." },
    { "type": "textarea", "id": "wallets_text", "label": "Text", "default": "Slim profiles, sized card slots and edges finished so they stay smooth in a pocket." },
    { "type": "header", "content": "Chapter III — Card holders" },
    { "type": "product", "id": "cards_film_product", "label": "Piece whose film plays", "info": "Leave empty for the theme's own unboxing film of the Valeria Leather Shoulder Bag." },
    { "type": "image_picker", "id": "cards_image", "label": "Photo", "info": "Optional. Upload the original photo for the sharpest result." },
    { "type": "text", "id": "cards_title", "label": "Headline", "default": "Your Initials. Your Identity." },
    { "type": "textarea", "id": "cards_text", "label": "Text", "default": "The smallest piece in the range, and the one most often made personal." },
    { "type": "header", "content": "Products" },
    { "type": "range", "id": "products_per_chapter", "min": 2, "max": 8, "step": 2, "default": 4, "label": "Products per chapter" }
  ],
  "presets": [{ "name": "Home: chapters" }]
}
{% endschema %}
