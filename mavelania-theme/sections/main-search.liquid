<section class="mv-search">
  <h1>{{ 'search.title' | t }}</h1>
  <form action="{{ routes.search_url }}" method="get" role="search">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t | escape }}" aria-label="{{ 'search.title' | t | escape }}">
    <button class="mv-primary-button" type="submit">{{ 'search.submit' | t }}</button>
  </form>
  {% if search.performed %}
    {% if search.results_count == 0 %}
      <p class="mv-search-empty">{{ 'search.no_results' | t }}</p>
    {% else %}
      {% paginate search.results by 24 %}
        <div class="mv-product-grid-list">
          {% for item in search.results %}
            {% if item.object_type == 'product' %}
              <article class="mv-product-card">
                <a href="{{ item.url }}">
                  <span class="mv-card-image">{% if item.featured_image %}{{ item.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320,480,640,900', sizes: '(max-width: 900px) 48vw, 32vw', alt: item.title }}{% endif %}</span>
                  <h2>{{ item.title }}</h2>
                  <p>{{ item.price | money }}</p>
                </a>
              </article>
            {% else %}
              <article class="mv-search-page-result">
                <a href="{{ item.url }}">
                  <h2>{{ item.title }}</h2>
                  {% if item.content != blank %}<p>{{ item.content | strip_html | truncatewords: 28 }}</p>{% endif %}
                </a>
              </article>
            {% endif %}
          {% endfor %}
        </div>
        {% if paginate.pages > 1 %}
          <nav class="mv-pagination" aria-label="{{ 'search.title' | t | escape }}">{{ paginate | default_pagination }}</nav>
        {% endif %}
      {% endpaginate %}
    {% endif %}
  {% endif %}
</section>
{% schema %}
{"name":"Search results","settings":[]}
{% endschema %}
