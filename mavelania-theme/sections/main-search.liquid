<section class="mv-search ms-search-page">
  <h1>{{ 'search.title' | t }}</h1>
  <form action="{{ routes.search_url }}" method="get" role="search">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t | escape }}" aria-label="{{ 'search.title' | t | escape }}">
    <button class="mv-primary-button" type="submit">{{ 'search.submit' | t }}</button>
  </form>
  {% if search.performed %}
    {% if search.results_count == 0 %}
      <p class="mv-search-empty">{{ 'search.no_results' | t }}</p>
    {% else %}
      {% paginate search.results by 24 %}
        <div class="ms-grid ms-grid--collection">
          {% for item in search.results %}
            {% if item.object_type == 'product' %}
              {% render 'product-card', product: item, heading: 'h2' %}
            {% else %}
              <article class="mv-search-page-result">
                <a href="{{ item.url }}">
                  <h2>{{ item.title }}</h2>
                  {% if item.content != blank %}<p>{{ item.content | strip_html | truncatewords: 28 }}</p>{% endif %}
                </a>
              </article>
            {% endif %}
          {% endfor %}
        </div>
        {% if paginate.pages > 1 %}
          <nav class="mv-pagination" aria-label="{{ 'search.title' | t | escape }}">{{ paginate | default_pagination }}</nav>
        {% endif %}
      {% endpaginate %}
    {% endif %}
  {% endif %}
</section>
{% schema %}
{"name":"Search results","settings":[]}
{% endschema %}
