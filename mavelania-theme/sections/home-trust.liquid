{%- comment -%}
  Home page, closing: the brand in three facts and a photograph, the
  questions people ask before ordering, and recently viewed pieces.
  Trust is carried by the facts themselves (company details, policies,
  one contact address), not by slogans.
{%- endcomment -%}
{%- liquid
  assign faq_page = pages['faq']
  if faq_page == blank
    assign faq_page = pages['sss']
  endif
  assign about_page = pages['about']
  if about_page == blank
    assign about_page = pages['about-us']
  endif
  assign contact_email = settings.contact_email | default: 'info@mavelania.com'
-%}
<div class="ms-home">

  <section class="ms-house" aria-labelledby="HomeHouseTitle" data-chapter="cream">
    <div class="ms-wrap ms-house__grid">
      <div class="ms-house__media">
        <img src="{{ 'men-leather-briefcase-model.webp' | asset_url }}" alt="{{ 'story.image_alt' | t | escape }}" width="1023" height="1537" loading="lazy" decoding="async">
      </div>
      <div class="ms-house__copy">
        <p class="ms-eyebrow">{{ 'story.eyebrow' | t }}</p>
        <h2 id="HomeHouseTitle" class="ms-house__title">{{ 'story.p1' | t }}</h2>
        <p>{{ 'story.p3' | t }}</p>

        <dl class="ms-house__facts">
          <div>
            <dt>{{ 'house.made_label' | t }}</dt>
            <dd>{{ 'house.made_value' | t }}</dd>
          </div>
          <div>
            <dt>{{ 'house.personal_label' | t }}</dt>
            <dd>{{ 'house.personal_value' | t }}</dd>
          </div>
          {%- if settings.return_window_days > 0 -%}
            <div>
              <dt>{{ 'house.returns_label' | t }}</dt>
              <dd>{{ 'products.returns_within' | t: days: settings.return_window_days }}{% if shop.refund_policy.url != blank %} · <a href="{{ shop.refund_policy.url }}">{{ 'footer.refund_policy' | t }}</a>{% endif %}</dd>
            </div>
          {%- endif -%}
          <div>
            <dt>{{ 'house.shipping_label' | t }}</dt>
            <dd>{{ 'house.shipping_value' | t }}{% if shop.shipping_policy.url != blank %} · <a href="{{ shop.shipping_policy.url }}">{{ 'footer.shipping_policy' | t }}</a>{% endif %}</dd>
          </div>
          {%- if settings.legal_name != blank -%}
            <div>
              <dt>{{ 'house.company_label' | t }}</dt>
              <dd>{{ settings.legal_name }}{% if settings.legal_jurisdiction != blank %}, {{ settings.legal_jurisdiction }}{% endif %}</dd>
            </div>
          {%- endif -%}
          <div>
            <dt>{{ 'house.contact_label' | t }}</dt>
            <dd><a href="mailto:{{ contact_email | escape }}">{{ contact_email }}</a></dd>
          </div>
        </dl>

        {%- if about_page != blank -%}
          <a class="ms-button ms-button--outline" href="{{ about_page.url }}">{{ 'story.cta' | t }} {% render 'icon', name: 'arrow-right' %}</a>
        {%- endif -%}
      </div>
    </div>
  </section>

  <section class="ms-section ms-wrap ms-faq" aria-labelledby="HomeFaqTitle" data-chapter="cream">
    <header class="ms-faq__head">
      <p class="ms-eyebrow">{{ 'home.faq_eyebrow' | t }}</p>
      <h2 id="HomeFaqTitle" class="ms-heading">{{ 'home.faq_heading' | t }}</h2>
      <p>{{ 'faq.intro' | t }}</p>
      <div class="ms-faq__actions">
        {%- if faq_page != blank -%}
          <a class="ms-button ms-button--outline" href="{{ faq_page.url }}">{{ 'home.faq_all' | t }}</a>
        {%- endif -%}
        <a class="ms-link" href="mailto:{{ contact_email | escape }}">{% render 'icon', name: 'mail' %} {{ contact_email }}</a>
      </div>
    </header>
    <div class="ms-accordion">
      <details open>
        <summary>{{ 'personalize.faq_q' | t }}{% render 'icon', name: 'chevron-down' %}</summary>
        <p>{{ 'personalize.faq_a' | t }}</p>
      </details>
      <details>
        <summary>{{ 'faq.q_shipping' | t }}{% render 'icon', name: 'chevron-down' %}</summary>
        <p>{{ 'faq.a_shipping' | t }}</p>
      </details>
      <details>
        <summary>{{ 'faq.q_returns' | t }}{% render 'icon', name: 'chevron-down' %}</summary>
        <p>{{ 'faq.a_returns' | t }}{% if shop.refund_policy.url != blank %} <a href="{{ shop.refund_policy.url }}">{{ 'faq.refund_link' | t }}</a>{% endif %}</p>
      </details>
      <details>
        <summary>{{ 'faq.q_payment' | t }}{% render 'icon', name: 'chevron-down' %}</summary>
        <p>{{ 'faq.a_payment' | t }}</p>
      </details>
      <details>
        <summary>{{ 'faq.q_international' | t }}{% render 'icon', name: 'chevron-down' %}</summary>
        <p>{{ 'faq.a_international' | t }}</p>
      </details>
    </div>
  </section>

  {% render 'recently-viewed' %}

</div>
{% schema %}
{ "name": "Home: house and help", "settings": [], "presets": [{ "name": "Home: house and help" }] }
{% endschema %}
