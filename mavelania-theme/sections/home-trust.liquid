{%- comment -%}
  Lower half of the home page: why buy here, a lifestyle banner, the most
  asked questions and the shopper's recently viewed products.

  The copy reuses what the About and FAQ pages already state, and the company
  line reads the registered-company settings, so nothing is claimed here that
  the store does not document elsewhere.
{%- endcomment -%}
{%- liquid
  assign faq_page = pages['faq']
  if faq_page == blank
    assign faq_page = pages['sss']
  endif
  assign about_page = pages['about']
  if about_page == blank
    assign about_page = pages['about-us']
  endif
  assign contact_page = pages['contact']
  assign legal_name = settings.legal_name | default: shop.name
-%}
<div class="ms-home">

  {%- if section.settings.show_why -%}
    <section class="ms-section ms-wrap ms-why" aria-labelledby="HomeWhyTitle">
      <div class="ms-why__image">
        <img src="{{ 'men-leather-briefcase-model.webp' | asset_url }}" alt="Man carrying a brown leather briefcase" width="1023" height="1537" loading="lazy" decoding="async">
      </div>
      <div class="ms-why__copy">
        <p class="ms-eyebrow">{{ 'home.why_eyebrow' | t }}</p>
        <h2 id="HomeWhyTitle" class="ms-heading">{{ 'home.why_heading' | t }}</h2>
        <p class="ms-why__lede">{{ 'about.lede' | t }}</p>

        <ul class="ms-why__list">
          <li>
            {% render 'icon', name: 'leather' %}
            <div><strong>{{ 'home.why_leather_title' | t }}</strong><span>{{ 'home.why_leather_copy' | t }}</span></div>
          </li>
          <li>
            {% render 'icon', name: 'needle' %}
            <div><strong>{{ 'home.why_craft_title' | t }}</strong><span>{{ 'home.why_craft_copy' | t }}</span></div>
          </li>
          <li>
            {% render 'icon', name: 'rfid' %}
            <div><strong>{{ 'home.why_rfid_title' | t }}</strong><span>{{ 'home.why_rfid_copy' | t }}</span></div>
          </li>
          <li>
            {% render 'icon', name: 'building' %}
            <div>
              <strong>{{ 'home.why_company_title' | t }}</strong>
              <span>
                {%- if settings.legal_jurisdiction != blank -%}
                  {{ 'home.why_company_copy' | t: name: legal_name, place: settings.legal_jurisdiction }}
                {%- else -%}
                  {{ 'home.why_company_copy_short' | t: name: legal_name }}
                {%- endif -%}
              </span>
            </div>
          </li>
        </ul>

        {%- if about_page != blank -%}
          <a class="ms-button ms-button--outline" href="{{ about_page.url }}">{{ 'home.about_link' | t }} {% render 'icon', name: 'arrow-right' %}</a>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- if section.settings.show_banner -%}
    <section class="ms-banner" aria-labelledby="HomeBannerTitle">
      <picture>
        <source media="(max-width:700px)" srcset="{{ 'before-footer-mobile.webp' | asset_url }}" width="900" height="1599">
        <img src="{{ 'before-footer.webp' | asset_url }}" alt="Woman carrying a brown leather shoulder bag" width="1881" height="836" loading="lazy" decoding="async">
      </picture>
      <div class="ms-banner__copy">
        <p class="ms-eyebrow">{{ 'collections.bags.card_title' | t }}</p>
        <h2 id="HomeBannerTitle" class="ms-heading">{{ 'home.banner_heading' | t }}</h2>
        <p>{{ 'home.banner_copy' | t }}</p>
        <a class="ms-button ms-button--primary" href="{{ routes.root_url }}collections/bags">{{ 'home.shop_bags' | t }} {% render 'icon', name: 'arrow-right' %}</a>
      </div>
    </section>
  {%- endif -%}

  {%- if section.settings.show_faq -%}
    <section class="ms-section ms-wrap ms-faq" aria-labelledby="HomeFaqTitle">
      <header class="ms-faq__head">
        <p class="ms-eyebrow">{{ 'home.faq_eyebrow' | t }}</p>
        <h2 id="HomeFaqTitle" class="ms-heading">{{ 'home.faq_heading' | t }}</h2>
        <p>{{ 'faq.intro' | t }}</p>
        <div class="ms-faq__actions">
          {%- if faq_page != blank -%}
            <a class="ms-button ms-button--outline" href="{{ faq_page.url }}">{{ 'home.faq_all' | t }}</a>
          {%- endif -%}
          {%- if contact_page != blank -%}
            <a class="ms-link" href="{{ contact_page.url }}">{% render 'icon', name: 'mail' %} {{ 'home.contact_us' | t }}</a>
          {%- else -%}
            <a class="ms-link" href="mailto:{{ settings.contact_email | default: 'info@mavelania.com' | escape }}">{% render 'icon', name: 'mail' %} {{ settings.contact_email | default: 'info@mavelania.com' }}</a>
          {%- endif -%}
        </div>
      </header>
      <div class="ms-accordion">
        <details open>
          <summary>{{ 'faq.q_handmade' | t }}{% render 'icon', name: 'chevron-down' %}</summary>
          <p>{{ 'faq.a_handmade' | t }}</p>
        </details>
        <details>
          <summary>{{ 'faq.q_shipping' | t }}{% render 'icon', name: 'chevron-down' %}</summary>
          <p>{{ 'faq.a_shipping' | t }}</p>
        </details>
        <details>
          <summary>{{ 'faq.q_returns' | t }}{% render 'icon', name: 'chevron-down' %}</summary>
          <p>{{ 'faq.a_returns' | t }}{% if shop.refund_policy.url != blank %} <a href="{{ shop.refund_policy.url }}">{{ 'faq.refund_link' | t }}</a>{% endif %}</p>
        </details>
        <details>
          <summary>{{ 'faq.q_payment' | t }}{% render 'icon', name: 'chevron-down' %}</summary>
          <p>{{ 'faq.a_payment' | t }}</p>
        </details>
        <details>
          <summary>{{ 'faq.q_international' | t }}{% render 'icon', name: 'chevron-down' %}</summary>
          <p>{{ 'faq.a_international' | t }}</p>
        </details>
      </div>
    </section>
  {%- endif -%}

  {% render 'recently-viewed' %}

</div>
{% schema %}
{
  "name": "Home: trust and help",
  "settings": [
    { "type": "checkbox", "id": "show_why", "label": "Show \"Why Mavelania\"", "default": true },
    { "type": "checkbox", "id": "show_banner", "label": "Show the lifestyle banner", "default": true },
    { "type": "checkbox", "id": "show_faq", "label": "Show the questions block", "default": true }
  ],
  "presets": [{ "name": "Home: trust and help" }]
}
{% endschema %}
