{%- liquid
  assign personalize_url = routes.all_products_collection_url | append: '?view=personalize'
  if pages['personalize'].url != blank
    assign personalize_url = pages['personalize'].url
  endif
  assign cards_url = routes.root_url | append: 'collections/types?q=Card%20Holder'
  if collections['card-holders'].url != blank
    assign cards_url = collections['card-holders'].url
  endif
-%}
<article class="mv-about ms-about">
  <header class="ms-about__hero">
    <p class="ms-eyebrow">{{ 'story.eyebrow' | t }}</p>
    <h1 class="ms-heading">{{ 'about.brand_title' | t }}</h1>
    <p class="ms-about__lede">{{ 'story.p1' | t }}</p>
  </header>

  <figure class="ms-about__figure">
    <img src="{{ 'before-footer.webp' | asset_url }}" alt="{{ 'home.slide_bag_alt' | t | escape }}" width="1400" height="622" loading="eager" fetchpriority="high" decoding="async">
  </figure>

  <section class="ms-about__statement" aria-labelledby="AboutStatementTitle">
    <h2 id="AboutStatementTitle" class="mv-visually-hidden">{{ 'about.statement_title' | t }}</h2>
    <p>{{ 'story.p2' | t }}</p>
    <p>{{ 'story.p3' | t }}</p>
    <p>{{ 'story.p4' | t }}</p>
    <p class="ms-about__signature">{{ 'story.signature' | t }}</p>
  </section>

  <section class="ms-about__principles" aria-labelledby="AboutPrinciplesTitle">
    <h2 id="AboutPrinciplesTitle" class="ms-heading">{{ 'philosophy.title' | t }}</h2>
    <div>
      <article><span>01</span><h3>{{ 'philosophy.craft_title' | t }}</h3><p>{{ 'philosophy.craft_text' | t }}</p></article>
      <article><span>02</span><h3>{{ 'philosophy.simplicity_title' | t }}</h3><p>{{ 'philosophy.simplicity_text' | t }}</p></article>
      <article><span>03</span><h3>{{ 'philosophy.personal_title' | t }}</h3><p>{{ 'philosophy.personal_text' | t }}</p></article>
    </div>
  </section>

  <section class="ms-about__make" aria-labelledby="AboutMakeTitle">
    <h2 id="AboutMakeTitle" class="ms-heading">{{ 'about.make_title' | t }}</h2>
    <p>{{ 'about.make_body_new' | t }}</p>
    <nav class="ms-catnav" aria-label="{{ 'about.make_title' | t | escape }}">
      {%- if collections['bags'].url != blank -%}<a href="{{ collections['bags'].url }}">{{ 'navigation.bags' | t }}</a>{%- endif -%}
      {%- if collections['wallets-purses'].url != blank -%}<a href="{{ collections['wallets-purses'].url }}">{{ 'navigation.wallets_short' | t }}</a>{%- endif -%}
      <a href="{{ cards_url }}">{{ 'navigation.card_holders' | t }}</a>
      {%- if collections['phone-cases'].products_count > 0 -%}<a href="{{ collections['phone-cases'].url }}">{{ 'navigation.phone_cases' | t }}</a>{%- endif -%}
      {%- if collections['accessories'].products_count > 0 -%}<a href="{{ collections['accessories'].url }}">{{ 'navigation.accessories' | t }}</a>{%- endif -%}
    </nav>
    <a class="ms-button ms-button--primary" href="{{ personalize_url }}">{% render 'icon', name: 'pen' %} {{ 'home.cta_personalize' | t }}</a>
  </section>

  <section class="mv-about-block mv-about-company" aria-labelledby="aboutCompany">
    <h2 id="aboutCompany">{{ 'about.company_title' | t }}</h2>
    <p class="mv-about-company-lede">{{ 'about.company_lede' | t }}</p>

    <dl class="mv-about-facts">
      <div>
        <dt>{{ 'about.fact_brand' | t }}</dt>
        <dd>{{ settings.organization_name | default: shop.name }}</dd>
      </div>

      {% if settings.legal_name != blank %}
        <div>
          <dt>{{ 'about.fact_legal' | t }}</dt>
          <dd>{{ settings.legal_name }}</dd>
        </div>
      {% endif %}

      {% if settings.legal_entity_type != blank %}
        <div>
          <dt>{{ 'about.fact_entity' | t }}</dt>
          <dd>{{ settings.legal_entity_type }}</dd>
        </div>
      {% endif %}

      {% if settings.legal_jurisdiction != blank %}
        <div>
          <dt>{{ 'about.fact_jurisdiction' | t }}</dt>
          <dd>{{ settings.legal_jurisdiction }}</dd>
        </div>
      {% endif %}

      {% if settings.legal_filing_id != blank %}
        <div>
          <dt>{{ 'about.fact_filing_id' | t }}</dt>
          <dd>{{ settings.legal_filing_id }}</dd>
        </div>
      {% endif %}

      {% if settings.legal_filing_date != blank %}
        <div>
          <dt>{{ 'about.fact_founded' | t }}</dt>
          <dd>{{ settings.legal_filing_date }}</dd>
        </div>
      {% elsif settings.founding_date != blank %}
        <div>
          <dt>{{ 'about.fact_founded' | t }}</dt>
          <dd>{{ settings.founding_date }}</dd>
        </div>
      {% endif %}

      {% if settings.legal_registered_agent != blank %}
        <div>
          <dt>{{ 'about.fact_agent' | t }}</dt>
          <dd>{{ settings.legal_registered_agent }}</dd>
        </div>
      {% endif %}

      {% if settings.legal_registered_office_street != blank %}
        <div>
          <dt>{{ 'about.fact_office' | t }}</dt>
          <dd>
            {{ settings.legal_registered_office_street }}<br>
            {{ settings.legal_registered_office_city }}, {{ settings.legal_registered_office_region }} {{ settings.legal_registered_office_postal }}<br>
            {{ settings.legal_registered_office_country_name | default: settings.legal_registered_office_country }}
          </dd>
        </div>
      {% endif %}

      <div>
        <dt>{{ 'about.fact_contact' | t }}</dt>
        <dd>
          <a href="mailto:{{ settings.contact_email | default: 'info@mavelania.com' | escape }}">
            {{ settings.contact_email | default: 'info@mavelania.com' }}
          </a>
        </dd>
      </div>
    </dl>

    {% if settings.legal_registered_office_street != blank %}
      <p class="mv-about-note">{{ 'about.office_note' | t }}</p>
    {% endif %}

    <p class="mv-about-note">
      {{ 'about.registry_note' | t }}
      <a href="https://wyobiz.wyo.gov/Business/FilingSearch.aspx" target="_blank" rel="noopener noreferrer">{{ 'about.registry_link' | t }}</a>
    </p>

    {% if page.content != blank %}
      <div class="rte mv-about-extra">{{ page.content }}</div>
    {% endif %}
  </section>
</article>

{% schema %}
{"name":"About page","settings":[]}
{% endschema %}
