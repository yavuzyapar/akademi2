{%- comment -%}
  Promo: the pitch on one side, a photograph of a person using the product on
  the other. The photograph is shown whole, at its own proportions, never
  cropped to a banner shape.

  Image, in order of preference:
    1. the image picked in the theme editor
    2. the main photo of the first in-stock product of the chosen collection
       (Phone Cases by default), which also makes the image link to a real
       product
    3. the built-in photo of a model holding a leather phone case
{%- endcomment -%}
{%- liquid
  assign promo_image = section.settings.image_desktop
  assign heading_tag = section.settings.heading_tag | default: 'h2'
  assign promo_collection = section.settings.collection
  if promo_collection == blank
    assign promo_collection = collections['phone-cases']
  endif
  assign promo_link = section.settings.cta_primary_link | default: promo_collection.url | default: routes.all_products_collection_url

  assign promo_has_product = false
  if promo_image == blank
    for candidate in promo_collection.products limit: 12
      if candidate.available and candidate.featured_image and promo_has_product == false
        assign promo_product = candidate
        assign promo_has_product = true
      endif
    endfor
  endif
-%}
<section
  class="ms-promo ms-promo--{{ section.settings.text_position }} ms-wrap"
  {% if section.settings.heading != blank %}aria-labelledby="PromoHeading-{{ section.id }}"{% endif %}
>
  <div class="ms-promo__copy">
    {% if section.settings.eyebrow != blank %}
      <p class="ms-eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <{{ heading_tag }} id="PromoHeading-{{ section.id }}" class="ms-heading ms-promo__heading">
        {{ section.settings.heading }}
      </{{ heading_tag }}>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="ms-promo__sub">{{ section.settings.subheading }}</p>
    {% endif %}

    {% if section.settings.point_1 != blank or section.settings.point_2 != blank or section.settings.point_3 != blank %}
      <ul class="ms-promo__points">
        {% if section.settings.point_1 != blank %}<li>{% render 'icon', name: 'check' %}<span>{{ section.settings.point_1 }}</span></li>{% endif %}
        {% if section.settings.point_2 != blank %}<li>{% render 'icon', name: 'check' %}<span>{{ section.settings.point_2 }}</span></li>{% endif %}
        {% if section.settings.point_3 != blank %}<li>{% render 'icon', name: 'check' %}<span>{{ section.settings.point_3 }}</span></li>{% endif %}
      </ul>
    {% endif %}

    {% if section.settings.cta_primary_label != blank or section.settings.cta_secondary_label != blank %}
      <div class="ms-promo__actions">
        {% if section.settings.cta_primary_label != blank %}
          <a class="ms-button ms-button--primary" href="{{ promo_link }}">
            <span>{{ section.settings.cta_primary_label }}</span>
            {% render 'icon', name: 'arrow-right' %}
          </a>
        {% endif %}
        {% if section.settings.cta_secondary_label != blank %}
          <a class="ms-button ms-button--outline" href="{{ section.settings.cta_secondary_link | default: routes.root_url }}">
            {{ section.settings.cta_secondary_label }}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>

  {%- if promo_image != blank -%}
    <a class="ms-promo__media" href="{{ promo_link }}" tabindex="-1" aria-hidden="true">
      {{ promo_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480,720,960,1400', sizes: '(max-width: 900px) 100vw, 44vw', alt: section.settings.image_alt }}
    </a>
  {%- elsif promo_has_product -%}
    <a class="ms-promo__media" href="{{ promo_product.url | within: promo_collection }}">
      {{ promo_product.featured_image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480,720,960,1400', sizes: '(max-width: 900px) 100vw, 44vw', alt: promo_product.title }}
      <span class="ms-promo__tag">
        <strong>{{ promo_product.title }}</strong>
        <span>{% if promo_product.price_varies %}{% assign promo_from = promo_product.price_min | money %}{{ 'products.from_price' | t: price: promo_from }}{% else %}{{ promo_product.price | money }}{% endif %}</span>
      </span>
    </a>
  {%- else -%}
    <a class="ms-promo__media" href="{{ promo_link }}" tabindex="-1" aria-hidden="true">
      <img src="{{ 'phone-case-model-new.webp' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" width="1086" height="1448" loading="lazy" decoding="async">
    </a>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Promo banner",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Image", "info": "The image is shown whole, next to the text. Use a photograph of a person using the product." },
    { "type": "image_picker", "id": "image_desktop", "label": "Image", "info": "Leave empty to use the main photo of the first in-stock product of the collection below." },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Used for the automatic image and the button link. Leave empty for Phone Cases." },
    { "type": "text", "id": "image_alt", "label": "Image description for screen readers", "default": "Model holding a leather phone case" },
    { "type": "header", "content": "Text" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Leather Phone Cases", "info": "To state compatibility, plain text only — e.g. \"Compatible with iPhone 15 Pro\". Never add the Apple logo or Apple's typeface: that implies official certification and Apple enforces it." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Leather cases built to last." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Timeless look. Everyday protection." },
    { "type": "select", "id": "heading_tag", "label": "Heading level", "options": [{"value":"h1","label":"H1 - only if this is the page's main heading"},{"value":"h2","label":"H2 - recommended"}], "default": "h2" },
    { "type": "select", "id": "text_position", "label": "Text position on desktop", "options": [{"value":"left","label":"Left"},{"value":"right","label":"Right"}], "default": "left" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "cta_primary_label", "label": "Primary button", "default": "Explore the collection" },
    { "type": "url", "id": "cta_primary_link", "label": "Primary link" },
    { "type": "text", "id": "cta_secondary_label", "label": "Secondary button" },
    { "type": "url", "id": "cta_secondary_link", "label": "Secondary link" },
    { "type": "header", "content": "Points" },
    { "type": "text", "id": "point_1", "label": "Point 1", "default": "Genuine leather" },
    { "type": "text", "id": "point_2", "label": "Point 2", "default": "Everyday protection" },
    { "type": "text", "id": "point_3", "label": "Point 3", "default": "Precision fit" }
  ],
  "presets": [{ "name": "Promo banner" }]
}
{% endschema %}
