{%- comment -%}
  Browsers do not let a website lock the screen orientation, so phones held
  sideways see this screen instead of the site (CSS in assets/mavelania-shop.css,
  block 27). Tablets and computers never see it.
{%- endcomment -%}
<div class="ms-upright" role="dialog" aria-modal="true" aria-labelledby="UprightTitle">
  <span class="ms-upright__em"><img src="{{ 'mavelania-logo-original-transparent.png' | asset_url }}" alt="" width="640" height="360" loading="lazy"></span>
  <svg class="ms-upright__phone" viewBox="0 0 48 48" aria-hidden="true" focusable="false"><rect x="15" y="6" width="18" height="34" rx="3.5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="24" cy="35" r="1.4" fill="currentColor"/><path d="M38 14a14 14 0 0 1 2 10" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M41 21l-1 3.6-3.2-2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  <p id="UprightTitle" class="ms-upright__title">{{ 'general.turn_upright' | t }}</p>
</div>
