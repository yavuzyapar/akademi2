{%- comment -%}
  Recently viewed products. Product pages record the visit in the browser's
  localStorage (assets/mavelania-shop.js) and this block is filled from it,
  so it stays hidden for first-time visitors.

  Params: exclude (product handle to leave out, used on the product page)
{%- endcomment -%}
<section class="ms-section ms-wrap ms-recent" aria-labelledby="RecentlyViewedTitle" data-recently-viewed{% if exclude != blank %} data-exclude="{{ exclude }}"{% endif %} hidden>
  <header class="ms-section__head">
    <div>
      <p class="ms-eyebrow">{{ 'recent.eyebrow' | t }}</p>
      <h2 id="RecentlyViewedTitle" class="ms-heading">{{ 'recent.title' | t }}</h2>
    </div>
  </header>
  <div class="ms-rail" data-recently-viewed-list></div>
</section>
