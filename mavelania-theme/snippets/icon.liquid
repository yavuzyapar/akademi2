{%- comment -%}
  Inline line icons, all drawn on a 24px grid with currentColor strokes.
  Usage: {% render 'icon', name: 'truck' %}
{%- endcomment -%}
<svg class="ms-icon ms-icon--{{ name }}" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'search' -%}
      <circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/>
    {%- when 'user' -%}
      <circle cx="12" cy="8" r="4"/><path d="M4.5 21a7.5 7.5 0 0 1 15 0"/>
    {%- when 'star' -%}
      <path d="m12 3.6 2.6 5.4 5.9.8-4.3 4.1 1 5.9L12 17l-5.2 2.8 1-5.9-4.3-4.1 5.9-.8Z"/>
    {%- when 'bag' -%}
      <path d="M5 8h14l1 13H4L5 8Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/>
    {%- when 'truck' -%}
      <path d="M2.5 6.5h11v10h-11z"/><path d="M13.5 10h4l3 3.2v3.3h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>
    {%- when 'globe' -%}
      <circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3c2.6 2.5 4 5.6 4 9s-1.4 6.5-4 9c-2.6-2.5-4-5.6-4-9s1.4-6.5 4-9Z"/>
    {%- when 'return' -%}
      <path d="M4 8h11a5 5 0 0 1 0 10H8"/><path d="M7.5 4.5 4 8l3.5 3.5"/>
    {%- when 'lock' -%}
      <rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/><path d="M12 14.5v2"/>
    {%- when 'shield' -%}
      <path d="M12 3 4.5 6v5.5c0 4.4 3 8 7.5 9.5 4.5-1.5 7.5-5.1 7.5-9.5V6L12 3Z"/><path d="m9 12 2.2 2.2L15.2 10"/>
    {%- when 'leather' -%}
      <path d="M7 3.5c1.5 1 3 1.5 5 1.5s3.5-.5 5-1.5l3 3.5-2 2.5c.7 2.5.7 5 0 7.5l1.5 2.5-3 1.5c-1.4-.6-2.9-1-4.5-1s-3.1.4-4.5 1l-3-1.5L6 17c-.7-2.5-.7-5 0-7.5L4 7l3-3.5Z"/>
    {%- when 'needle' -%}
      <path d="M20.5 3.5c-4.5.5-9.5 4-13 9l-3 6.5 6.5-3c5-3.5 8.5-8.5 9-13Z"/><path d="M15.5 7.5 14 9"/><path d="M4.5 19c-1 1-.5 2 .5 2"/>
    {%- when 'card' -%}
      <rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="M3 10h18"/><path d="M7 14.5h3"/>
    {%- when 'rfid' -%}
      <rect x="3" y="6" width="12" height="12" rx="2"/><path d="M17.5 9.5a4 4 0 0 1 0 5"/><path d="M20 7.5a7.2 7.2 0 0 1 0 9"/><path d="M6.5 10.5h5"/>
    {%- when 'building' -%}
      <path d="M4 20.5V5.5l8-2.5 8 2.5v15"/><path d="M2.5 20.5h19"/><path d="M9 9.5h1.5M13.5 9.5H15M9 13h1.5M13.5 13H15"/><path d="M10.5 20.5v-4h3v4"/>
    {%- when 'mail' -%}
      <rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/>
    {%- when 'chat' -%}
      <path d="M4 5.5h16v11H9.5L5.5 20v-3.5H4z"/><path d="M8 9.5h8M8 12.5h5"/>
    {%- when 'check' -%}
      <path d="m5 12.5 4.5 4.5L19 7.5"/>
    {%- when 'arrow-right' -%}
      <path d="M4.5 12h15"/><path d="m13.5 6 6 6-6 6"/>
    {%- when 'arrow-left' -%}
      <path d="M19.5 12h-15"/><path d="m10.5 6-6 6 6 6"/>
    {%- when 'chevron-down' -%}
      <path d="m6 9 6 6 6-6"/>
    {%- when 'close' -%}
      <path d="M6 6l12 12M18 6 6 18"/>
    {%- when 'plus' -%}
      <path d="M12 5.5v13M5.5 12h13"/>
    {%- when 'minus' -%}
      <path d="M5.5 12h13"/>
    {%- when 'pause' -%}
      <path d="M9 6v12M15 6v12"/>
    {%- when 'play' -%}
      <path d="M8 5.5v13l10.5-6.5L8 5.5Z"/>
    {%- when 'menu' -%}
      <path d="M4 7h16M4 12h16M4 17h16"/>
    {%- when 'trash' -%}
      <path d="M5 7h14"/><path d="M9.5 7V4.5h5V7"/><path d="M7 7l.8 12.5h8.4L17 7"/>
    {%- when 'clock' -%}
      <circle cx="12" cy="12" r="9"/><path d="M12 7v5.5l3.5 2"/>
    {%- when 'scissors' -%}
      <circle cx="6.5" cy="6.5" r="2.5"/><circle cx="6.5" cy="17.5" r="2.5"/><path d="M8.6 7.9 20 17M8.6 16.1 20 7"/>
    {%- when 'burnish' -%}
      <rect x="3.5" y="13" width="17" height="5.5" rx="1.5"/><path d="M7 13c0-3 2.2-5.5 5-5.5s5 2.5 5 5.5"/><path d="M12 3.5v2M6.2 5.4l1.2 1.4M17.8 5.4l-1.2 1.4"/>
    {%- when 'bolt' -%}
      <path d="M13 3 5.5 13.5H11L10 21l8.5-11H13l0-7Z"/>
    {%- when 'tag' -%}
      <path d="M3.5 12.5V4.5h8l9 9-8 8-9-9Z"/><circle cx="8" cy="9" r="1.3"/>
    {%- when 'drop' -%}
      <path d="M12 3.5c3.5 4 5.5 7 5.5 10a5.5 5.5 0 0 1-11 0c0-3 2-6 5.5-10Z"/>
  {%- endcase -%}
</svg>
