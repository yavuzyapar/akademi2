{%- comment -%}
  The house mark: Mavelania's own logo and script wordmark (the same
  lockup as the header and footer), and the one line the visitor should
  leave with: genuine leather, made by hand.
  Params: tone (data-chapter tone, default cream)
{%- endcomment -%}
<section class="ms-seal" aria-labelledby="SealTitle" data-chapter="{{ tone | default: 'cream' }}">
  <div class="ms-wrap ms-seal__grid">
    <div class="ms-seal__mark">
      <span class="ms-seal__lockup" aria-hidden="true">
        <span class="ms-seal__em"><img src="{{ 'mavelania-logo-original-transparent.png' | asset_url }}" alt="" width="640" height="360" loading="lazy"></span>
        <span class="ms-seal__script">Mavelania</span>
      </span>
      <span class="ms-seal__sign">{{ 'seal.sign' | t }}</span>
    </div>
    <div class="ms-seal__copy">
      <h2 id="SealTitle" class="ms-seal__title">{{ 'seal.title_html' | t }}</h2>
      <p class="ms-seal__text">{{ 'seal.text' | t }}</p>
      <ul class="ms-seal__facts">
        <li><strong>{{ 'seal.fact1_title' | t }}</strong><span>{{ 'seal.fact1_text' | t }}</span></li>
        <li><strong>{{ 'seal.fact2_title' | t }}</strong><span>{{ 'seal.fact2_text' | t }}</span></li>
        <li><strong>{{ 'seal.fact3_title' | t }}</strong><span>{{ 'seal.fact3_text' | t }}</span></li>
      </ul>
    </div>
  </div>
</section>
