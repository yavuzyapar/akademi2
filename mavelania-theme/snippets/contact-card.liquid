{%- comment -%}
  "Write to us": a warm two-part card. Left, who answers and how (the
  address, the reply time, social accounts). Right, a short form that
  Shopify sends to the shop's contact address (set it to
  info@mavelania.com in Settings → Store details). Used on the home page
  and the Contact page.

  Params:
    id       unique id for the form on the page (default 'ContactForm')
    heading  'h1' on the Contact page, 'h2' elsewhere
{%- endcomment -%}
{%- liquid
  assign cc_id = id | default: 'ContactForm'
  assign cc_h = heading | default: 'h2'
  assign cc_mail = settings.contact_email | default: 'info@mavelania.com'
-%}
<section class="ms-contact" aria-labelledby="{{ cc_id }}Title" data-chapter="cream">
  <div class="ms-wrap"><div class="ms-contact__card">
    <div class="ms-contact__intro">
      <p class="ms-eyebrow">{{ 'contact_card.eyebrow' | t }}</p>
      <{{ cc_h }} id="{{ cc_id }}Title" class="ms-contact__title">{{ 'contact_card.title_html' | t }}</{{ cc_h }}>
      <p class="ms-contact__lede">{{ 'contact_card.lede' | t }}</p>
      <ul class="ms-contact__promises" role="list">
        <li>{% render 'icon', name: 'mail' %}<span><strong>{{ 'contact_card.p1_title' | t }}</strong>{{ 'contact_card.p1_text' | t }}</span></li>
        <li>{% render 'icon', name: 'clock' %}<span><strong>{{ 'contact_card.p2_title' | t }}</strong>{{ 'contact_card.p2_text' | t }}</span></li>
        <li>{% render 'icon', name: 'lock' %}<span><strong>{{ 'contact_card.p3_title' | t }}</strong>{{ 'contact_card.p3_text' | t }}</span></li>
      </ul>
      <a class="ms-contact__mail" href="mailto:{{ cc_mail | escape }}" data-no-veil>{% render 'icon', name: 'mail' %} {{ cc_mail }}</a>
    </div>

    {%- form 'contact', id: cc_id, class: 'ms-contact__form' -%}
      {%- if form.posted_successfully? -%}
        <div class="ms-contact__done" role="status">
          {% render 'icon', name: 'check' %}
          <p><strong>{{ 'contact_card.done_title' | t }}</strong>{{ 'contact.success' | t }}</p>
        </div>
      {%- else -%}
        {%- if form.errors -%}
          <div class="ms-contact__errors" role="alert">
            <ul>{%- for field in form.errors -%}<li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>{%- endfor -%}</ul>
          </div>
        {%- endif -%}
        <fieldset class="ms-contact__topics">
          <legend>{{ 'contact_card.topic' | t }}</legend>
          {%- assign topics = 'contact_card.topic_order,contact_card.topic_product,contact_card.topic_personal,contact_card.topic_other' | split: ',' -%}
          {%- for topic in topics -%}
            <label class="ms-contact__chip"><input type="radio" name="contact[topic]" value="{{ topic | t | escape }}"{% if forloop.first %} checked{% endif %}><span>{{ topic | t }}</span></label>
          {%- endfor -%}
        </fieldset>
        <div class="ms-contact__pair">
          <div class="ms-contact__field">
            <label for="{{ cc_id }}Name">{{ 'contact.form_name' | t }}</label>
            <input id="{{ cc_id }}Name" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}" placeholder="{{ 'contact_card.ph_name' | t | escape }}" required>
          </div>
          <div class="ms-contact__field">
            <label for="{{ cc_id }}Email">{{ 'contact.form_email' | t }}</label>
            <input id="{{ cc_id }}Email" type="email" name="contact[email]" autocomplete="email" value="{{ form.email }}" placeholder="{{ 'contact_card.ph_email' | t | escape }}" required>
          </div>
        </div>
        <div class="ms-contact__field">
          <label for="{{ cc_id }}Order">{{ 'contact.form_order' | t }}</label>
          <input id="{{ cc_id }}Order" type="text" name="contact[order number]" placeholder="{{ 'contact_card.ph_order' | t | escape }}">
        </div>
        <div class="ms-contact__field">
          <label for="{{ cc_id }}Message">{{ 'contact.form_message' | t }}</label>
          <textarea id="{{ cc_id }}Message" name="contact[body]" rows="5" placeholder="{{ 'contact_card.ph_message' | t | escape }}" required>{{ form.body }}</textarea>
        </div>
        <div class="ms-contact__send">
          <button class="ms-button ms-button--primary" type="submit">{{ 'contact.form_submit' | t }} {% render 'icon', name: 'arrow-right' %}</button>
          <p>{{ 'contact_card.send_note' | t: email: cc_mail }}</p>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div></div>
</section>
