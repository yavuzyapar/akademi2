{%- comment -%}
  "Make It Yours": personalization as a brand feature.

  The methods and colours listed are the union of what the personalizable
  products state in their own data, and the products shown are exactly the
  ones that can be personalized. When no photo of a real personalized
  piece has been chosen, a live preview lets the visitor see their own
  initials in each available colour; it is labelled as a preview.

  Params: personalize_url, image (optional image_picker value), heading_tag
{%- endcomment -%}
{%- liquid
  assign mi_methods = ''
  assign mi_colors = ''
  assign mi_count = 0
-%}
{%- capture mi_cards -%}
  {%- for mi_product in collections.all.products limit: 250 -%}
    {%- capture mi_info -%}{% render 'personalization-info', product: mi_product %}{%- endcapture -%}
    {%- assign mi_info = mi_info | strip -%}
    {%- if mi_info != blank and mi_product.available -%}
      {%- assign mi_parts = mi_info | split: '|' -%}
      {%- assign mi_methods = mi_methods | append: mi_parts[1] -%}
      {%- assign mi_colors = mi_colors | append: mi_parts[2] -%}
      {%- assign mi_count = mi_count | plus: 1 -%}
      {%- if mi_count <= 8 -%}
        <a class="ms-mini ms-mini--pers" href="{{ mi_product.url }}#personalize">
          <span class="ms-mini__image">{% if mi_product.featured_image %}{{ mi_product.featured_image | image_url: width: 360 | image_tag: loading: 'lazy', alt: '' }}{% endif %}</span>
          <span class="ms-mini__title">{{ mi_product.title }}</span>
          <span class="ms-mini__price">{{ mi_product.price | money }}</span>
        </a>
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign mi_methods = mi_methods | split: ',' | uniq | compact -%}
{%- assign mi_colors = mi_colors | split: ',' | uniq | compact -%}

{%- if mi_count > 0 -%}
  <section class="ms-section ms-personal" id="make-it-yours" aria-labelledby="MakeItYoursTitle" data-personal-demo>
    <div class="ms-wrap ms-personal__grid">
      <div class="ms-personal__visual">
        {%- if image != blank -%}
          {{ image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480,720,960,1200', sizes: '(max-width: 900px) 92vw, 46vw', alt: image.alt | default: '' }}
        {%- else -%}
          <div class="ms-personal__hide">
            <span class="ms-personal__plate" data-demo-plate data-tone="{{ mi_colors.first | downcase | default: 'transparent' }}"><span data-demo-text>M.A.</span></span>
            <span class="ms-personal__stitch" aria-hidden="true"></span>
          </div>
          <p class="ms-personal__caption">{{ 'personalize.demo_caption' | t }}</p>
        {%- endif -%}
      </div>

      <div class="ms-personal__copy">
        <p class="ms-eyebrow">{{ 'personalize.eyebrow' | t }}</p>
        <h2 id="MakeItYoursTitle" class="ms-heading">{{ 'personalize.title' | t }}</h2>
        <p class="ms-personal__lede">{{ 'personalize.lede' | t }}</p>

        {%- if image == blank -%}
          <div class="ms-personal__try">
            <label for="DemoInitials">{{ 'personalize.try_label' | t }}</label>
            <input id="DemoInitials" type="text" maxlength="12" value="M.A." autocomplete="off" autocapitalize="characters" spellcheck="false" data-demo-input>
          </div>
        {%- endif -%}

        <dl class="ms-personal__facts">
          <div>
            <dt>{{ 'personalize.what_label' | t }}</dt>
            <dd>{{ 'personalize.what_value' | t }}</dd>
          </div>
          {%- if mi_methods.size > 0 -%}
            <div>
              <dt>{{ 'personalize.method_label' | t }}</dt>
              <dd>{{ mi_methods | join: ' · ' }}</dd>
            </div>
          {%- endif -%}
          {%- if mi_colors.size > 0 -%}
            <div>
              <dt>{{ 'personalize.color_label' | t }}</dt>
              <dd class="ms-personal__colors">
                {%- for color in mi_colors -%}
                  {%- assign color_key = color | downcase -%}
                  <button type="button" class="ms-personal__color{% if forloop.first %} is-active{% endif %}" data-demo-tone="{{ color_key }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"{% if image != blank %} disabled{% endif %}>
                    <span class="ms-pers__dot ms-pers__dot--{{ color_key }}" aria-hidden="true"></span>{{ color }}
                  </button>
                {%- endfor -%}
              </dd>
            </div>
          {%- endif -%}
        </dl>

        <p class="ms-personal__policy">{{ 'personalize.returns_note' | t }}{% if shop.refund_policy.url != blank %} <a href="{{ shop.refund_policy.url }}">{{ 'faq.refund_link' | t }}</a>{% endif %}</p>

        <div class="ms-personal__actions">
          <a class="ms-button ms-button--primary" href="{{ personalize_url }}">{% render 'icon', name: 'pen' %} {{ 'personalize.cta' | t }}</a>
        </div>
      </div>
    </div>

    <div class="ms-wrap">
      <div class="ms-minirail ms-personal__products">{{ mi_cards }}</div>
    </div>
  </section>
{%- endif -%}
