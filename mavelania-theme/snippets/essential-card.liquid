{%- comment -%}
  One of the three "Selected essentials": photo, name, price, a short line
  from the product's own description and, only when the product's data says
  so, the "Personalizable" label.

  Params: product, label (e.g. "The signature bag")
{%- endcomment -%}
{%- liquid
  assign ess_text = product.description | split: '<h' | first | split: '<ul' | first | strip_html | replace: '&nbsp;', ' ' | strip | truncatewords: 22
  assign ess_on_sale = false
  if product.compare_at_price > product.price
    assign ess_on_sale = true
  endif
-%}
{%- capture ess_pers -%}{% render 'personalization-info', product: product %}{%- endcapture -%}
{%- assign ess_pers = ess_pers | strip -%}
<article class="ms-essential">
  <a class="ms-essential__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
    {%- if product.featured_image -%}
      {{ product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360,540,720,1000', sizes: '(max-width: 900px) 88vw, 31vw', alt: '' }}
    {%- endif -%}
    {%- if ess_pers != blank -%}
      <span class="ms-tag ms-tag--pers">{% render 'icon', name: 'pen' %} {{ 'personalize.label' | t }}</span>
    {%- endif -%}
  </a>
  <div class="ms-essential__body">
    <p class="ms-essential__label">{{ label }}</p>
    <h3 class="ms-essential__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    <p class="ms-essential__price{% if ess_on_sale %} is-sale{% endif %}">
      {%- if product.price_varies -%}
        {%- assign ess_from = product.price_min | money -%}
        {{ 'products.from_price' | t: price: ess_from }}
      {%- else -%}
        {{ product.price | money }}
      {%- endif -%}
      {%- if ess_on_sale %} <s>{{ product.compare_at_price | money }}</s>{% endif -%}
    </p>
    {%- if ess_text != blank -%}<p class="ms-essential__text">{{ ess_text }}</p>{%- endif -%}
    <a class="ms-link" href="{{ product.url }}">{{ 'home.view_piece' | t }} {% render 'icon', name: 'arrow-right' %}</a>
  </div>
</article>
