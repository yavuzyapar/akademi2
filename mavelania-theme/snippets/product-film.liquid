{%- comment -%}
  "In motion" on the product page: the film of this very piece, beside a
  few words. Shows, in this order:
    1) a video uploaded to the product in the Shopify admin (product media);
    2) the theme film mapped to this product in snippets/film-name.liquid.
  Renders nothing for products without a film.

  Params: product
{%- endcomment -%}
{%- liquid
  assign pf_native = product.media | where: 'media_type', 'video' | first
  capture pf_name
    render 'film-name', handle: product.handle
  endcapture
  assign pf_name = pf_name | strip
-%}
{%- if pf_native != blank or pf_name != blank -%}
  <section class="ms-pfilm" aria-labelledby="ProductFilmTitle">
    <div class="ms-pfilm__media">
      {%- if pf_native != blank -%}
        <div class="ms-film ms-film--native">{{ pf_native | video_tag: controls: true, muted: true, loop: true, playsinline: true, preload: 'none', image_size: '900x' }}</div>
      {%- else -%}
        {% render 'film', name: pf_name, label: product.title %}
      {%- endif -%}
    </div>
    <div class="ms-pfilm__copy">
      <p class="ms-eyebrow">{{ 'film.product_eyebrow' | t }}</p>
      <h2 id="ProductFilmTitle" class="ms-heading">{{ 'film.product_title' | t }}</h2>
      <p>{{ 'film.product_text' | t: title: product.title }}</p>
      <ul class="ms-pfilm__points">
        <li>{% render 'icon', name: 'leather' %}<span>{{ 'seal.fact1_title' | t }}</span></li>
        <li>{% render 'icon', name: 'needle' %}<span>{{ 'seal.fact2_title' | t }}</span></li>
        <li>{% render 'icon', name: 'pen' %}<span>{{ 'personalize.available' | t }}</span></li>
      </ul>
    </div>
  </section>
{%- endif -%}
