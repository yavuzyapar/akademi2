{%- comment -%}
  Product story: the piece in daily life. Its film (a video uploaded to the
  product in the Shopify admin comes first, then the theme film) beside up
  to four lookbook photographs from the theme. Both come from
  snippets/film-name.liquid. Renders nothing for a product with neither.

  Desktop: the film on the left runs the full height of the words and a
  row of photographs on the right; two photographs show at a time and the
  row scrolls sideways (arrows, trackpad or drag).
  Phones: words, the film in a 4:5 window, then the photos in a swipe row.

  Params: product
{%- endcomment -%}
{%- liquid
  assign ps_native = product.media | where: 'media_type', 'video' | first
  capture ps_media
    render 'film-name', handle: product.handle
  endcapture
  assign ps_media = ps_media | strip | split: '|'
  assign ps_film = ps_media[0]
  assign ps_short = ps_media[1]
  assign ps_looks = ps_media[2] | plus: 0
  if ps_looks > 4
    assign ps_looks = 4
  endif
  assign ps_has_film = false
  if ps_native != blank or ps_film != blank
    assign ps_has_film = true
  endif
-%}
{%- if ps_has_film or ps_looks > 0 -%}
  <section class="ms-pstory{% unless ps_has_film %} ms-pstory--photos{% endunless %}" aria-labelledby="ProductStoryTitle">
    {%- if ps_has_film -%}
      <div class="ms-pstory__film">
        {%- if ps_native != blank -%}
          <div class="ms-film ms-film--native">{{ ps_native | video_tag: autoplay: true, muted: true, loop: true, playsinline: true, preload: 'metadata', image_size: '900x' }}</div>
        {%- else -%}
          {% render 'film', name: ps_film, label: product.title %}
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="ms-pstory__body">
      <header class="ms-pstory__copy">
        <p class="ms-eyebrow">{{ 'film.product_eyebrow' | t }}</p>
        <h2 id="ProductStoryTitle" class="ms-heading">{{ 'film.product_title' | t }}</h2>
        <p>{{ 'film.product_text' | t: title: product.title }}</p>
      </header>
      {%- if ps_looks > 0 -%}
        <div class="ms-pstory__rail" data-rail>
        <ul class="ms-pstory__looks ms-pstory__looks--{{ ps_looks }}" role="list" data-rail-track>
          {%- for n in (1..ps_looks) -%}
            {%- assign ps_file = 'look-' | append: ps_short | append: '-' | append: n | append: '.webp' -%}
            <li class="ms-pstory__look">
              <img src="{{ ps_file | asset_url }}" alt="{{ 'film.look_label' | t: n: n, title: product.title | escape }}" width="900" height="900" loading="lazy" decoding="async">
            </li>
          {%- endfor -%}
        </ul>
        {%- if ps_looks > 2 -%}
          <button class="ms-pstory__arrow ms-pstory__arrow--prev" type="button" data-rail-prev aria-label="{{ 'film.look_prev' | t | escape }}" disabled>{% render 'icon', name: 'arrow-right' %}</button>
          <button class="ms-pstory__arrow ms-pstory__arrow--next" type="button" data-rail-next aria-label="{{ 'film.look_next' | t | escape }}">{% render 'icon', name: 'arrow-right' %}</button>
        {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}
