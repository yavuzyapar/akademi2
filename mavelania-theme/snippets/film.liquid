{%- comment -%}
  A short silent film from the theme assets (assets/<name>.mp4 with
  assets/<name>-poster.webp). Nothing is downloaded until it scrolls into
  view; it then plays muted on a loop and pauses when it leaves the screen
  (assets/mavelania-shop.js). With reduced motion or data saver it waits
  for the play button.

  Params:
    name     asset base name, e.g. 'film-valeria'
    label    accessible description
    wide     true for the 16:9 film (default is portrait 9:16)
    product  optional product shown as a link over the foot of the film
{%- endcomment -%}
<div class="ms-film{% if wide %} ms-film--wide{% endif %}" data-film>
  <video class="ms-film__video" muted loop playsinline preload="none" poster="{{ name | append: '-poster.webp' | asset_url }}"{% if wide %} width="854" height="480"{% else %} width="480" height="854"{% endif %} aria-label="{{ label | escape }}" data-film-video>
    <source src="{{ name | append: '.mp4' | asset_url }}" type="video/mp4">
  </video>
  <button class="ms-film__toggle" type="button" data-film-toggle data-label-pause="{{ 'film.pause' | t | escape }}" data-label-play="{{ 'film.play' | t | escape }}" aria-label="{{ 'film.play' | t | escape }}">
    <span class="ms-film__icon ms-film__icon--play">{% render 'icon', name: 'play' %}</span>
    <span class="ms-film__icon ms-film__icon--pause">{% render 'icon', name: 'pause' %}</span>
  </button>
  {%- if product.title != blank -%}
    <a class="ms-film__tag" href="{{ product.url }}">
      <span class="ms-film__tag-copy">
        <small>{{ 'film.in_this_film' | t }}</small>
        <strong>{{ product.title }}</strong>
      </span>
      {% render 'icon', name: 'arrow-right' %}
    </a>
  {%- endif -%}
</div>
